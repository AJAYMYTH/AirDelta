{
  "name": "@airdelta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bot": "tsx src/bot/polling-runner.ts",
    "bot:prod": "node dist/bot/polling-runner.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@airdelta/air-adapters": "workspace:*",
    "@airdelta/engine": "workspace:*",
    "@airdelta/fix-library": "workspace:*",
    "@airdelta/i18n": "workspace:*",
    "@airdelta/schemas": "workspace:*",
    "@google/genai": "^3.6.1",
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.48.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.34.0",
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

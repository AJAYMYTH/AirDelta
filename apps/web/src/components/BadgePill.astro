---
import type { Badge } from "@airdelta/schemas";
import { getGlossaryTerm } from "@airdelta/i18n";

interface Props {
  badge: Badge;
  lang?: string;
  className?: string;
}

const { badge, lang = "en", className = "" } = Astro.props;

const badgeConfig: Record<Badge, { labelKey: string; i18nKey: string; bg: string; text: string; border: string; dot: string }> = {
  measured: {
    labelKey: "badge_measured",
    i18nKey: "badgeMeasured",
    bg: "bg-emerald-50",
    text: "text-emerald-800",
    border: "border-emerald-200",
    dot: "bg-emerald-500"
  },
  forecast: {
    labelKey: "badge_forecast",
    i18nKey: "badgeForecast",
    bg: "bg-orange-50",
    text: "text-orange-900",
    border: "border-orange-200",
    dot: "bg-orange-500"
  },
  modelled: {
    labelKey: "badge_modelled",
    i18nKey: "badgeModelled",
    bg: "bg-slate-100",
    text: "text-slate-800",
    border: "border-slate-200",
    dot: "bg-slate-600"
  },
  assumed: {
    labelKey: "badge_assumed",
    i18nKey: "badgeAssumed",
    bg: "bg-amber-50",
    text: "text-amber-800",
    border: "border-amber-200",
    dot: "bg-amber-500"
  }
};

const cfg = badgeConfig[badge] || badgeConfig.modelled;
const label = getGlossaryTerm(cfg.labelKey, lang);
---

<span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${cfg.bg} ${cfg.text} ${cfg.border} font-mono tracking-tight shadow-xs ${className}`}>
  <span class={`w-1.5 h-1.5 rounded-full ${cfg.dot}`}></span>
  <span data-i18n={cfg.i18nKey}>{label}</span>
</span>

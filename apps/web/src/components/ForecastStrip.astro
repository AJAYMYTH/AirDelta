---
import type { AirForecast } from "@airdelta/schemas";
import { getGlossaryTerm } from "@airdelta/i18n";
import BadgePill from "./BadgePill.astro";

interface Props {
  forecast: AirForecast;
  lang?: string;
}

const { forecast, lang = "en" } = Astro.props;
const cleanest = forecast.cleanestWindow;
const cleanestLabel = getGlossaryTerm("cleanest_window", lang);

const formattedHourly = forecast.hourly.slice(0, 12).map((item) => {
  const pmVal = item.pm25 || 0;
  const height = Math.min(100, Math.max(20, Math.round(pmVal / 4)));
  let barColor = "bg-emerald-500";
  if (pmVal > 250) {
    barColor = "bg-red-500";
  } else if (pmVal > 120) {
    barColor = "bg-amber-500";
  }
  return {
    pm25Formatted: item.pm25 ? Math.round(item.pm25) : "--",
    height,
    barColor,
    timeLabel: new Date(item.ts).toLocaleTimeString([], { hour: "2-digit" })
  };
});
---

<div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-xl">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <h3 class="text-base font-semibold text-slate-100">Hourly Forecast</h3>
      <BadgePill badge={forecast.badge} lang={lang} />
    </div>
    <span class="text-xs text-slate-400">96-Hour Horizon</span>
  </div>

  {cleanest && (
    <div class="mb-5 p-3.5 bg-gradient-to-r from-emerald-950/70 to-slate-900 border border-emerald-500/30 rounded-xl flex items-center justify-between">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-emerald-400 text-sm font-semibold">✨ {cleanestLabel}</span>
          <span class="text-xs text-emerald-300 font-mono">
            {new Date(cleanest.startTs).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })} – {new Date(cleanest.endTs).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}
          </span>
        </div>
        <p class="text-xs text-slate-300 mt-1">{cleanest.reason}</p>
      </div>
      <div class="text-right">
        <span class="text-xs text-slate-400 block">Expected PM2.5</span>
        <span class="text-sm font-bold text-emerald-400">{cleanest.expectedPm25} µg/m³</span>
      </div>
    </div>
  )}

  <div class="overflow-x-auto pb-2 -mx-1 px-1">
    <div class="flex items-end gap-3 min-w-max">
      {formattedHourly.map((item) => (
        <div class="flex flex-col items-center gap-1.5 w-14">
          <span class="text-[11px] font-mono text-slate-300">{item.pm25Formatted}</span>
          <div class="w-7 bg-slate-800 rounded-t-md flex items-end h-24 p-0.5">
            <div class={`w-full rounded-t ${item.barColor} opacity-85 transition-all`} style={`height: ${item.height}%;`}></div>
          </div>
          <span class="text-[10px] text-slate-400 font-mono">
            {item.timeLabel}
          </span>
        </div>
      ))}
    </div>
  </div>
</div>

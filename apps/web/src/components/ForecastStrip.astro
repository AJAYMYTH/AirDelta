---
import type { AirForecast } from "@airdelta/schemas";
import { getGlossaryTerm } from "@airdelta/i18n";
import BadgePill from "./BadgePill.astro";

interface Props {
  forecast: AirForecast;
  lang?: string;
}

const { forecast, lang = "en" } = Astro.props;
const cleanest = forecast.cleanestWindow;
const cleanestLabel = getGlossaryTerm("cleanest_window", lang);

const formattedHourly = forecast.hourly.slice(0, 12).map((item) => {
  const pmVal = item.pm25 || 0;
  const height = Math.min(100, Math.max(20, Math.round(pmVal / 4.2)));
  let barColor = "bg-emerald-500";
  if (pmVal > 250) {
    barColor = "bg-orange-600";
  } else if (pmVal > 120) {
    barColor = "bg-amber-500";
  }
  return {
    pm25Formatted: item.pm25 ? Math.round(item.pm25) : "--",
    height,
    barColor,
    timeLabel: new Date(item.ts).toLocaleTimeString([], { hour: "2-digit" })
  };
});
---

<div class="bg-white border border-[#e8e8e8] rounded-2xl p-6 shadow-xs">
  <div class="flex items-center justify-between mb-5">
    <div class="flex items-center gap-2.5">
      <h3 class="text-base font-bold text-[#262626]">Hourly Exposure Horizon</h3>
      <BadgePill badge={forecast.badge} lang={lang} />
    </div>
    <span class="text-xs text-[#8c8c8c] font-medium font-mono">96-Hour CAMS Model</span>
  </div>

  {cleanest && (
    <div class="mb-6 p-4 bg-[#fff7ed] border border-[#fed7aa] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[#ea580c]">✨ {cleanestLabel}</span>
          <span class="text-xs text-[#9a3412] font-mono font-semibold bg-white/80 px-2 py-0.5 rounded border border-[#ffedd5]">
            {new Date(cleanest.startTs).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })} – {new Date(cleanest.endTs).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}
          </span>
        </div>
        <p class="text-xs text-[#7c2d12] mt-1 leading-relaxed">{cleanest.reason}</p>
      </div>
      <div class="text-left sm:text-right">
        <span class="text-[11px] text-[#9a3412] block font-medium">Expected Low PM2.5</span>
        <span class="text-base font-extrabold text-[#ea580c] font-mono">{cleanest.expectedPm25} µg/m³</span>
      </div>
    </div>
  )}

  <div class="overflow-x-auto pb-2 -mx-1 px-1">
    <div class="flex items-end gap-3 min-w-max pt-2">
      {formattedHourly.map((item) => (
        <div class="flex flex-col items-center gap-2 w-14">
          <span class="text-[11px] font-mono font-bold text-[#595959]">{item.pm25Formatted}</span>
          <div class="w-8 bg-[#f5f5f5] rounded-t-md flex items-end h-28 p-1 border-x border-t border-[#e8e8e8]">
            <div class={`w-full rounded-t ${item.barColor} transition-all`} style={`height: ${item.height}%;`}></div>
          </div>
          <span class="text-[10px] text-[#8c8c8c] font-mono font-medium">
            {item.timeLabel}
          </span>
        </div>
      ))}
    </div>
  </div>
  <div class="flex justify-between text-[11px] text-[#8c8c8c] mt-4 pt-3 border-t border-[#f0f0f0]">
    <span>Bar height proportional to ambient particulate concentration</span>
    <span class="font-medium text-[#ea580c]">Orange = Severe Inversion Peak</span>
  </div>
</div>

---
import ChevronDown from "lucide-astro/ChevronDown";
import Check from "lucide-astro/Check";

export interface DropdownOption {
  value: string;
  label: string;
  sublabel?: string;
  i18nKey?: string;
  subI18nKey?: string;
}

interface Props {
  id: string;
  name?: string;
  heading?: string;
  headingI18n?: string;
  options: DropdownOption[];
  selectedValue?: string;
  align?: "start" | "end";
  pill?: boolean;
  triggerClass?: string;
  minWidth?: number;
}

const {
  id,
  name,
  heading,
  headingI18n,
  options,
  selectedValue = options[0]?.value || "",
  align = "start",
  pill = false,
  triggerClass = "",
  minWidth = 220
} = Astro.props;

const activeOption = options.find((o) => o.value === selectedValue) || options[0];
const roundedBtn = pill ? "rounded-full px-3.5 py-1.5" : "rounded-xl px-3.5 py-2";
---

<div class="relative w-full" data-tdropdown={id}>
  <input type="hidden" id={id} name={name || id} value={activeOption?.value || ""} />

  <button
    id={`${id}-trigger`}
    type="button"
    class={`w-full flex items-center justify-between gap-2 bg-[#f7f9fa] hover:bg-[#ebebeb] border border-[#d4d4d4] text-xs font-bold text-[#171717] transition-colors cursor-pointer press-scale ${roundedBtn} ${triggerClass}`}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`${id}-menu`}
  >
    <span id={`${id}-label`} class="truncate text-left">{activeOption?.label || ""}</span>
    <ChevronDown id={`${id}-chevron`} class="w-3.5 h-3.5 text-[#737373] transition-transform duration-200 shrink-0" aria-hidden="true" />
  </button>

  <div
    id={`${id}-menu`}
    popover="manual"
    data-origin={`top-${align === "end" ? "right" : "left"}`}
    data-align={align}
    data-min-width={String(minWidth)}
    class="t-dropdown dropdown-surface rounded-2xl p-1.5 w-64 space-y-0.5"
    role="menu"
    aria-labelledby={`${id}-trigger`}
    inert
  >
    {heading && (
      <div
        class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[#737373] border-b border-[#e5e5e5]/70 mb-1"
        data-i18n={headingI18n}
      >
        {heading}
      </div>
    )}
    {options.map((opt) => {
      const isSelected = opt.value === activeOption?.value;
      return (
        <button
          type="button"
          data-value={opt.value}
          role="menuitemradio"
          aria-checked={isSelected ? "true" : "false"}
          class={`td-item w-full flex items-center justify-between gap-2 px-3 py-2 rounded-xl text-xs text-left transition-colors cursor-pointer hover:bg-[#f7f9fa] ${
            isSelected ? "bg-[#fff7ed] text-[#ea580c] font-bold" : "text-[#525252]"
          }`}
        >
          <div class="flex flex-col min-w-0">
            <span class="td-item-label font-bold text-[#171717] leading-tight truncate" data-i18n={opt.i18nKey}>
              {opt.label}
            </span>
            {opt.sublabel && (
              <span class="text-[10px] text-[#737373] leading-none mt-0.5 truncate" data-i18n={opt.subI18nKey}>
                {opt.sublabel}
              </span>
            )}
          </div>
          <Check class={`td-check w-4 h-4 text-[#ea580c] shrink-0 transition-opacity ${isSelected ? "" : "opacity-0"}`} aria-hidden="true" />
        </button>
      );
    })}
  </div>
</div>

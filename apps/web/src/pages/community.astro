---
import Layout from "../layouts/Layout.astro";
import BadgePill from "../components/BadgePill.astro";
import CountUp from "../components/lightswind/count-up";
import TransitionDropdown from "../components/TransitionDropdown.astro";
import delhiSmogData from "../../../../fixtures/delhi-smog-nov2026.json";
import { getGrapStageForAqi, getAllGrapStages, AdvisoryService, type AirSnapshot } from "@airdelta/schemas";
import { getAllLanguages } from "@airdelta/i18n";
import Copy from "lucide-astro/Copy";
import Check from "lucide-astro/Check";
import ShieldAlert from "lucide-astro/ShieldAlert";
import MessageCircle from "lucide-astro/MessageCircle";

const snapshot = delhiSmogData.snapshot as AirSnapshot;

const aqi = snapshot.indexValue || 385;
const activeGrapRule = getGrapStageForAqi(aqi);
const allStages = getAllGrapStages();
const languages = getAllLanguages();

const advisoryService = new AdvisoryService();
const rwaAdvisoryHindi = advisoryService.generateAdvisory("rwa_residents", snapshot, "hi");

const audienceOptions = [
  { value: "rwa_residents", label: "Housing Society & Apartments", i18nKey: "audSocieties" },
  { value: "school_community", label: "School & College Campus", i18nKey: "audSchools" },
  { value: "workplace", label: "Office & Workplace", i18nKey: "audWorkplaces" },
  { value: "general_public", label: "General Public", i18nKey: "audPublic" }
];
const noticeLangOptions = languages.map((l) => ({
  value: l.code,
  label: `${l.nativeName} (${l.name})`
}));
---

<Layout title="AirDelta — Share Air Alerts">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <a href="/" class="text-xs font-semibold text-[#737373] hover:text-[#ea580c] transition-colors" data-i18n="backHome">← Home</a>
        <span class="text-xs text-[#d4d4d4]">/</span>
        <span class="text-xs text-[#ea580c] font-semibold" data-i18n="communityTitle">Share Alert</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#171717]" data-i18n="communityHeading">Neighborhood Air Alerts</h1>
          <p id="community-subtitle" class="text-xs sm:text-sm text-[#525252] mt-1" data-i18n="communitySubtitle">
            Clear, ready-to-share alerts for housing societies, schools, and offices using live air data
          </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <BadgePill badge="measured" />
          <span id="community-grap-pill" class="text-xs text-[#ea580c] bg-[#fff7ed] border border-[#fed7aa] px-3.5 py-1 rounded-full font-mono font-bold flex items-center gap-1.5">
            <ShieldAlert class="w-3.5 h-3.5" aria-hidden="true" />
            <span>{activeGrapRule.stageName} Active</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Active Advisory Preview Card -->
    <div class="p-4 sm:p-6 md:p-8 bg-white border border-[#e5e5e5] rounded-3xl shadow-xs space-y-6 stagger-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#e5e5e5]">
        <div class="min-w-0">
          <span id="advisory-audience-label" class="text-[11px] font-bold text-[#ea580c] uppercase tracking-wider block">For: Housing Societies &amp; Apartments</span>
          <h2 id="advisory-headline" class="text-lg sm:text-xl font-bold text-[#171717] mt-1">{rwaAdvisoryHindi.headline}</h2>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full sm:w-auto shrink-0">
          <a
            id="btn-whatsapp-notice"
            href={`https://wa.me/?text=${encodeURIComponent(rwaAdvisoryHindi.shareCardText || rwaAdvisoryHindi.headline)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-action px-5 py-2.5 bg-[#ea580c] hover:bg-[#c2410c] text-white text-xs font-bold rounded-full shadow-sm transition-all flex items-center justify-center gap-2 whitespace-nowrap cursor-pointer press-scale"
          >
            <MessageCircle class="w-4 h-4 shrink-0" aria-hidden="true" />
            <span data-i18n="sendWhatsApp">Send on WhatsApp</span>
          </a>
          <button
            id="btn-copy-notice"
            type="button"
            class="px-4 py-2.5 bg-[#f7f9fa] hover:bg-[#ebebeb] border border-[#d4d4d4] text-[#171717] text-xs font-bold rounded-full transition-all flex items-center justify-center gap-1.5 whitespace-nowrap cursor-pointer press-scale"
          >
            <Copy id="copy-icon" class="w-3.5 h-3.5 text-[#ea580c] shrink-0" aria-hidden="true" />
            <span id="copy-btn-text" data-i18n="copyTextBtn">Copy</span>
          </button>
        </div>
      </div>

      <!-- Audience & 13-Language Transitions.dev Dropdown Controls -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="flex flex-col gap-1.5">
          <span class="font-bold text-[#171717]" data-i18n="whoIsThisFor">Who Is This For?</span>
          <TransitionDropdown id="advisory-audience" name="audience" options={audienceOptions} selectedValue="rwa_residents" />
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="font-bold text-[#171717]" data-i18n="chooseNoticeLang">Choose Language (13 Supported)</span>
          <TransitionDropdown id="advisory-lang" name="lang" heading="Choose Your Language" headingI18n="chooseLangTitle" options={noticeLangOptions} selectedValue="hi" />
        </div>
      </div>

      <p id="advisory-body" class="text-xs sm:text-sm text-[#525252] leading-relaxed">{rwaAdvisoryHindi.body}</p>

      <!-- Action Bullet Points -->
      <div class="space-y-2.5">
        <span class="text-xs font-bold text-[#171717] uppercase tracking-wider block" data-i18n="whatToDoToday">What to Do Today:</span>
        <div id="advisory-bullets" class="space-y-2">
          {rwaAdvisoryHindi.actionBulletPoints.map((point) => (
            <div class="flex items-start gap-3 p-3.5 bg-[#f7f9fa] border border-[#e5e5e5] rounded-2xl text-xs text-[#171717]">
              <span class="w-2 h-2 rounded-full bg-[#ea580c] mt-1.5 shrink-0" aria-hidden="true"></span>
              <span class="leading-relaxed">{point}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e5e5e5] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-[#525252]">
        <span id="advisory-status-line" role="status" aria-live="polite" class="flex items-center gap-2 font-medium">
          <span class="w-2 h-2 rounded-full bg-[#15803d]"></span> Matched to live air readings &amp; official GRAP rules
        </span>
        <span class="font-mono text-[#ea580c] font-semibold" data-i18n="readyToPaste">Ready to paste in WhatsApp or Telegram</span>
      </div>

      <div id="copy-toast" role="status" aria-live="polite" class="hidden p-4 bg-[#dcfce7] border border-[#86efac] text-[#15803d] rounded-2xl text-xs font-semibold text-center flex items-center justify-center gap-2">
        <Check class="w-4 h-4 text-[#15803d]" aria-hidden="true" />
        <span data-i18n="noticeCopied">Notice copied! Paste it directly into your neighborhood WhatsApp group.</span>
      </div>
    </div>

    <!-- Anonymous Community Impact Ledger (k >= 5 Anonymity Standard) -->
    <div class="p-4 sm:p-6 md:p-8 bg-white border border-[#e5e5e5] rounded-3xl shadow-xs space-y-4 stagger-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#dcfce7] text-[#15803d] border border-[#86efac] font-bold" data-i18n="privacyStandardBadge">
            Privacy Protected (5+ Homes)
          </span>
          <h2 class="text-base sm:text-lg font-bold text-[#171717] mt-1.5" data-i18n="communityLedgerHeading">Sector 14 Neighborhood Clean-Air Impact</h2>
        </div>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="text-[#525252] font-medium" data-i18n="testGroupSize">Test Group Size:</span>
          <button type="button" class="k-sim-btn px-3 py-1 rounded-full bg-[#ea580c] text-white font-bold cursor-pointer" data-k="18" data-i18n="homesShown">18 Homes (Shown)</button>
          <button type="button" class="k-sim-btn px-3 py-1 rounded-full bg-[#f7f9fa] text-[#525252] border border-[#e5e5e5] font-semibold cursor-pointer" data-k="3" data-i18n="homesHidden">3 Homes (&lt;5 Hidden)</button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e5e5e5]">
          <span class="text-[#525252] block font-medium" data-i18n="participatingHomes">Participating Homes</span>
          <span id="k-households" class="text-2xl font-extrabold text-[#171717] font-mono mt-1 block">
            <CountUp client:load syncId="k-households" value={18} suffix=" Families" duration={0.8} className="text-2xl font-extrabold text-[#171717] font-mono" />
          </span>
          <span id="k-status-note" class="text-[10px] text-[#15803d] font-medium">5+ homes rule met (zero individual tracking)</span>
        </div>
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e5e5e5]">
          <span class="text-[#525252] block font-medium" data-i18n="dustKeptOut">Dust Kept Out of Lungs</span>
          <span id="k-pm25-saved" class="text-2xl font-extrabold text-[#ea580c] font-mono mt-1 block">
            <CountUp client:load syncId="k-pm25-saved" value={3.3} decimals={1} suffix=" g" duration={0.8} className="text-2xl font-extrabold text-[#ea580c] font-mono" />
          </span>
          <span class="text-[10px] text-[#525252]" data-i18n="totalAvoidedNote">Total neighborhood exposure avoided</span>
        </div>
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e5e5e5]">
          <span class="text-[#525252] block font-medium" data-i18n="safeHabitsCompleted">Safe Habits Completed</span>
          <span id="k-actions-count" class="text-2xl font-extrabold text-[#15803d] font-mono mt-1 block">
            <CountUp client:load syncId="k-actions-count" value={72} suffix=" Actions" duration={0.8} className="text-2xl font-extrabold text-[#15803d] font-mono" />
          </span>
          <span class="text-[10px] text-[#15803d] font-medium" data-i18n="safeHabitsNote">Metro switches, window timing &amp; exhaust fans</span>
        </div>
      </div>
    </div>

    <!-- Official CAQM GRAP Policy Stages Matrix -->
    <div class="space-y-4 stagger-card">
      <div>
        <span class="text-[11px] font-bold text-[#ea580c] uppercase tracking-wider block" data-i18n="officialAlertLevels">Official Alert Levels</span>
        <h2 class="text-lg font-bold text-[#171717]" data-i18n="grapMatrixHeading">Graded Response Action Plan (GRAP) Stages</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {allStages.map((stage) => {
          const isActive = stage.stage === activeGrapRule.stage;
          const cardClass = isActive
            ? "border-2 border-[#ea580c] bg-[#fff7ed]/50 shadow-xs"
            : "border border-[#e8e8e8] bg-white shadow-xs";

          return (
            <div data-grap-stage={stage.stage} class={`grap-stage-card p-5 rounded-2xl ${cardClass} space-y-3 flex flex-col justify-between`}>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold font-mono text-[#8c8c8c]">{stage.stage}</span>
                  <span class={`grap-current-pill text-[10px] px-2.5 py-0.5 rounded-full bg-[#ea580c] text-white font-bold uppercase ${isActive ? "" : "hidden"}`} data-i18n="grapCurrentLabel">
                    Current
                  </span>
                </div>
                <h3 class="text-sm font-bold text-[#262626]">{stage.stageName}</h3>
                <span class="text-[11px] font-mono text-[#ea580c] font-semibold block">{stage.aqiThreshold}</span>
                <p class="text-[11px] text-[#595959] leading-snug">{stage.cpcbCategory} Category</p>
              </div>

              <div class="pt-2 border-t border-[#e8e8e8] text-[10px] text-[#595959] leading-tight">
                <strong class="text-[#262626]" data-i18n="keyMandateLabel">Key Mandate:</strong> {stage.rwaMandates[0]}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <script>
    import { apiFetchJson, buildWhatsAppShareUrl, dispatchCountUpUpdate, getSelectedCity } from "../scripts/api-client.ts";
    import { setTransitionDropdownValue } from "../scripts/dropdown.ts";

    const whatsappNoticeBtn = document.getElementById("btn-whatsapp-notice") as HTMLAnchorElement | null;
    const copyBtn = document.getElementById("btn-copy-notice");
    const copyBtnText = document.getElementById("copy-btn-text");
    const toast = document.getElementById("copy-toast");
    const headline = document.getElementById("advisory-headline");
    const body = document.getElementById("advisory-body");
    const bullets = document.getElementById("advisory-bullets");
    const audienceSelect = document.getElementById("advisory-audience") as HTMLInputElement | null;
    const langSelect = document.getElementById("advisory-lang") as HTMLInputElement | null;
    const grapPill = document.getElementById("community-grap-pill");
    const statusLine = document.getElementById("advisory-status-line");

    let currentShareCard = "";

    function buildCommunityNoticeText(): string {
      if (currentShareCard) return currentShareCard;
      const bulletLines = Array.from(bullets?.querySelectorAll("span.leading-relaxed") || [])
        .map((el) => `• ${el.textContent?.trim()}`)
        .filter(Boolean);
      return [
        headline?.textContent?.trim() || "",
        "",
        body?.textContent?.trim() || "",
        bulletLines.length > 0 ? `\n${bulletLines.join("\n")}` : "",
        `\nAirDelta Live Report: ${window.location.origin}`
      ].filter(Boolean).join("\n");
    }

    function syncCommunityWhatsAppHref() {
      if (whatsappNoticeBtn) {
        whatsappNoticeBtn.href = buildWhatsAppShareUrl(buildCommunityNoticeText());
      }
    }

    function renderAdvisory(adv: any) {
      if (headline) headline.textContent = adv.headline;
      if (body) body.textContent = adv.body;
      currentShareCard = adv.shareCardText || "";
      syncCommunityWhatsAppHref();

      if (bullets && Array.isArray(adv.actionBulletPoints)) {
        const nodes = adv.actionBulletPoints.map((p: string) => {
          const row = document.createElement("div");
          row.className = "flex items-start gap-3 p-3.5 bg-[#f7f9fa] border border-[#e8e8e8] rounded-2xl text-xs text-[#262626]";
          const icon = document.createElement("span");
          icon.className = "w-2 h-2 rounded-full bg-[#ea580c] mt-1.5 shrink-0";
          icon.setAttribute("aria-hidden", "true");
          const txt = document.createElement("span");
          txt.className = "leading-relaxed";
          txt.textContent = p;
          row.replaceChildren(icon, txt);
          return row;
        });
        bullets.replaceChildren(...nodes);
      }

      // Update active GRAP stage card
      document.querySelectorAll(".grap-stage-card").forEach((card) => {
        const st = card.getAttribute("data-grap-stage");
        const pill = card.querySelector(".grap-current-pill");
        if (st === adv.grapStage) {
          card.classList.add("border-2", "border-[#ea580c]", "bg-[#fff7ed]/50");
          card.classList.remove("border", "border-[#e8e8e8]", "bg-white");
          pill?.classList.remove("hidden");
        } else {
          card.classList.remove("border-2", "border-[#ea580c]", "bg-[#fff7ed]/50");
          card.classList.add("border", "border-[#e8e8e8]", "bg-white");
          pill?.classList.add("hidden");
        }
      });

      if (grapPill) {
        const span = grapPill.querySelector("span");
        if (span) span.textContent = `${adv.grapStage === "NONE" ? "Baseline" : adv.grapStage.replace("_", " ")} Active`;
      }
    }

    async function fetchLiveAdvisory() {
      const city = getSelectedCity();
      const audience = audienceSelect?.value || "rwa_residents";
      const lang = langSelect?.value || "hi";

      try {
        const adv = await apiFetchJson<any>("/v1/advisories", {
          method: "POST",
          body: JSON.stringify({
            audience,
            lang,
            gridCell: city.cell
          })
        });
        renderAdvisory(adv);
        if (statusLine) statusLine.textContent = `Generated live for ${city.label} in ${lang.toUpperCase()}`;
      } catch {
        if (statusLine) statusLine.textContent = "API offline — displaying build-time Hindi/English fallback";
      }
    }

    async function loadGroupImpact(memberCount: number) {
      const hhEl = document.getElementById("k-households");
      const noteEl = document.getElementById("k-status-note");
      const pmEl = document.getElementById("k-pm25-saved");
      const actEl = document.getElementById("k-actions-count");

      try {
        const res = await apiFetchJson<any>(`/v1/advisories/groups/sec-14-rwa/impact?memberCount=${memberCount}`);
        if (res.isAnonymitySatisfied) {
          if (hhEl) dispatchCountUpUpdate("k-households", { value: Number(res.activeHouseholds), suffix: " Families", decimals: 0 });
          if (noteEl) {
            noteEl.textContent = "5+ homes rule met (zero individual tracking)";
            noteEl.className = "text-[10px] text-[#15803d] font-medium";
          }
          if (pmEl) dispatchCountUpUpdate("k-pm25-saved", { value: Number(res.estimatedCommunityPm25PreventedGrams), suffix: " g", decimals: 1 });
          if (actEl) dispatchCountUpUpdate("k-actions-count", { value: Number(res.totalActionsTaken), suffix: " Actions", decimals: 0 });
        } else {
          if (hhEl) dispatchCountUpUpdate("k-households", { value: null, fallbackText: "Hidden (< 5)" });
          if (noteEl) {
            noteEl.textContent = "Hidden to protect privacy when fewer than 5 homes participate";
            noteEl.className = "text-[10px] text-[#ea580c] font-bold";
          }
          if (pmEl) dispatchCountUpUpdate("k-pm25-saved", { value: null, fallbackText: "Hidden" });
          if (actEl) dispatchCountUpUpdate("k-actions-count", { value: null, fallbackText: "Hidden" });
        }
      } catch {
        // ignore if offline
      }
    }

    audienceSelect?.addEventListener("change", fetchLiveAdvisory);
    langSelect?.addEventListener("change", fetchLiveAdvisory);

    document.querySelectorAll(".k-sim-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const k = parseInt(btn.getAttribute("data-k") || "18", 10);
        document.querySelectorAll(".k-sim-btn").forEach((b) => {
          b.className = "k-sim-btn px-3 py-1 rounded-full bg-[#f7f9fa] text-[#595959] border border-[#e8e8e8] font-semibold cursor-pointer";
        });
        btn.className = "k-sim-btn px-3 py-1 rounded-full bg-[#ea580c] text-white font-bold cursor-pointer";
        loadGroupImpact(k);
      });
    });

    window.addEventListener("airdelta:langchange", (e: any) => {
      const lang = e.detail?.lang;
      if (lang) {
        setTransitionDropdownValue("advisory-lang", lang, false);
        fetchLiveAdvisory();
      }
    });

    syncCommunityWhatsAppHref();

    whatsappNoticeBtn?.addEventListener("click", () => {
      syncCommunityWhatsAppHref();
    });

    copyBtn?.addEventListener("click", () => {
      const textToCopy = buildCommunityNoticeText();
      navigator.clipboard.writeText(textToCopy).then(() => {
        if (copyBtnText) copyBtnText.textContent = "Copied!";
        if (toast) {
          toast.classList.remove("hidden");
          setTimeout(() => {
            toast.classList.add("hidden");
            if (copyBtnText) copyBtnText.textContent = (window as any).AirDeltaRuntime?.t?.("copyTextBtn") || "Copy";
          }, 3000);
        }
      });
    });

    fetchLiveAdvisory();
    loadGroupImpact(18);
  </script>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import BadgePill from "../components/BadgePill.astro";
import { AirDataService } from "@airdelta/air-adapters";
import { getGrapStageForAqi, getAllGrapStages, AdvisoryService } from "@airdelta/schemas";
import { 
  Copy, 
  Check, 
  ShieldAlert 
} from "lucide-astro";

const airService = new AirDataService({ replayMode: true });
const snapshot = await airService.getAirSnapshot(28.6139, 77.2090);

const aqi = snapshot.indexValue || 385;
const activeGrapRule = getGrapStageForAqi(aqi);
const allStages = getAllGrapStages();

const advisoryService = new AdvisoryService();
const rwaAdvisoryHindi = advisoryService.generateAdvisory("rwa_residents", snapshot, "hi");
const rwaAdvisoryEng = advisoryService.generateAdvisory("rwa_residents", snapshot, "en");
---

<Layout title="AirDelta — Multilingual Community Advisories">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <a href="/" class="text-xs font-semibold text-[#8c8c8c] hover:text-[#ea580c] transition-colors">← Back to Today</a>
        <span class="text-xs text-[#d9d9d9]">/</span>
        <span class="text-xs text-[#ea580c] font-semibold" data-i18n="communityTitle">Society & Campus Notices</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#262626]">Multilingual Community Advisories</h1>
          <p class="text-xs sm:text-sm text-[#595959] mt-1">
            Authoritative, non-alarmist action notices for RWAs, schools, and offices · Delhi-NCR
          </p>
        </div>
        <div class="flex items-center gap-2">
          <BadgePill badge="forecast" />
          <span class="text-xs text-[#ea580c] bg-[#fff7ed] border border-[#fed7aa] px-3.5 py-1 rounded-full font-mono font-bold flex items-center gap-1.5">
            <ShieldAlert class="w-3.5 h-3.5" />
            <span>{activeGrapRule.stageName} Active</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Active Advisory Preview Card (DJI Showroom Card) -->
    <div class="p-6 sm:p-8 bg-white border border-[#e8e8e8] rounded-3xl shadow-xs space-y-6 stagger-card">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#e8e8e8]">
        <div>
          <span class="text-[11px] font-bold text-[#ea580c] uppercase tracking-wider block">Target: RWA & Apartment Society Residents</span>
          <h2 id="advisory-headline" class="text-xl font-bold text-[#262626] mt-1">{rwaAdvisoryHindi.headline}</h2>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto">
          <button
            id="btn-copy-notice"
            type="button"
            class="btn-action px-6 py-2.5 bg-[#ea580c] hover:bg-[#c2410c] text-white text-xs font-bold rounded-full shadow-sm transition-all flex items-center gap-2 whitespace-nowrap cursor-pointer press-scale"
          >
            <Copy id="copy-icon" class="w-4 h-4" />
            <span id="copy-btn-text" data-i18n="copyNotice">Copy WhatsApp Notice</span>
          </button>
        </div>
      </div>

      <!-- Quick Language Switch Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
        <span class="text-[#8c8c8c] font-semibold mr-1 text-[11px]">Notice Language:</span>
        <button id="btn-lang-hi" type="button" class="px-4 py-1.5 rounded-full bg-[#ea580c] text-white font-semibold cursor-pointer transition-colors press-scale">
          हिन्दी (Hindi)
        </button>
        <button id="btn-lang-en" type="button" class="px-4 py-1.5 rounded-full bg-[#f7f9fa] text-[#595959] hover:text-[#262626] border border-[#e8e8e8] font-medium cursor-pointer transition-colors press-scale">
          English
        </button>
      </div>

      <p id="advisory-body" class="text-xs sm:text-sm text-[#595959] leading-relaxed">{rwaAdvisoryHindi.body}</p>

      <!-- Action Bullet Points -->
      <div class="space-y-2.5">
        <span class="text-xs font-bold text-[#262626] uppercase tracking-wider block">Official Mandates & Protocol:</span>
        <div id="advisory-bullets" class="space-y-2">
          {rwaAdvisoryHindi.actionBulletPoints.map((point) => (
            <div class="flex items-start gap-3 p-3.5 bg-[#f7f9fa] border border-[#e8e8e8] rounded-2xl text-xs text-[#262626]">
              <span class="text-[#ea580c] text-sm leading-none mt-0.5">⚠️</span>
              <span class="leading-relaxed">{point}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Raw text storage for clipboard -->
      <pre id="share-text-box" class="hidden">{rwaAdvisoryHindi.shareCardText}</pre>
      <pre id="share-text-box-en" class="hidden">{rwaAdvisoryEng.shareCardText}</pre>

      <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-[#595959]">
        <span class="flex items-center gap-2 font-medium">
          <span class="w-2 h-2 rounded-full bg-[#15803d]"></span> Verified CPCB NAQI Emergency Action Framework
        </span>
        <span class="font-mono text-[#ea580c] font-semibold">Ready to forward on WhatsApp / Telegram</span>
      </div>

      <div id="copy-toast" class="hidden p-4 bg-[#dcfce7] border border-[#86efac] text-[#15803d] rounded-2xl text-xs font-semibold text-center flex items-center justify-center gap-2">
        <Check class="w-4 h-4 text-[#15803d]" />
        <span data-i18n="noticeCopied">Notice copied to clipboard! Paste directly into your resident WhatsApp group.</span>
      </div>
    </div>

    <!-- Anonymous Community Impact Ledger (k >= 5 Anonymity Standard) -->
    <div class="p-6 sm:p-8 bg-white border border-[#e8e8e8] rounded-3xl shadow-xs space-y-4 stagger-card">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#dcfce7] text-[#15803d] border border-[#86efac] font-bold">
            k ≥ 5 Privacy Standard
          </span>
          <h2 class="text-base sm:text-lg font-bold text-[#262626] mt-1.5">Sector 14 RWA Collective Action Ledger</h2>
        </div>
        <span class="text-xs font-mono text-[#8c8c8c]">Gurugram / Delhi Grid</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8]">
          <span class="text-[#595959] block font-medium">Participating Households</span>
          <span class="text-2xl font-extrabold text-[#262626] font-mono mt-1 block">18 Families</span>
          <span class="text-[10px] text-[#15803d] font-medium">k ≥ 5 satisfied (Zero individual tracking)</span>
        </div>
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8]">
          <span class="text-[#595959] block font-medium">Prevented Inhaled PM2.5</span>
          <span class="text-2xl font-extrabold text-[#ea580c] font-mono mt-1 block">1.15 kg</span>
          <span class="text-[10px] text-[#595959]">Cumulative exposure avoided</span>
        </div>
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8]">
          <span class="text-[#595959] block font-medium">Avoided Vehicle Emissions</span>
          <span class="text-2xl font-extrabold text-[#15803d] font-mono mt-1 block">5.4 kg CO₂e</span>
          <span class="text-[10px] text-[#15803d] font-medium">Metro switches & carpooling</span>
        </div>
      </div>
    </div>

    <!-- Official CAQM GRAP Policy Stages Matrix -->
    <div class="space-y-4 stagger-card">
      <div>
        <span class="text-[11px] font-bold text-[#ea580c] uppercase tracking-wider block">Statutory Framework</span>
        <h2 class="text-lg font-bold text-[#262626]">CAQM Graded Response Action Plan (GRAP) Matrix</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {allStages.map((stage) => {
          const isActive = stage.stage === activeGrapRule.stage;
          const cardClass = isActive
            ? "border-2 border-[#ea580c] bg-[#fff7ed]/50 shadow-xs"
            : "border border-[#e8e8e8] bg-white shadow-xs";

          return (
            <div class={`p-5 rounded-2xl ${cardClass} space-y-3 flex flex-col justify-between`}>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold font-mono text-[#8c8c8c]">{stage.stage}</span>
                  {isActive && (
                    <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-[#ea580c] text-white font-bold uppercase">
                      Current
                    </span>
                  )}
                </div>
                <h3 class="text-sm font-bold text-[#262626]">{stage.stageName}</h3>
                <span class="text-[11px] font-mono text-[#ea580c] font-semibold block">{stage.aqiThreshold}</span>
                <p class="text-[11px] text-[#595959] leading-snug">{stage.cpcbCategory} Category</p>
              </div>

              <div class="pt-2 border-t border-[#e8e8e8] text-[10px] text-[#595959] leading-tight">
                <strong class="text-[#262626]">Key Mandate:</strong> {stage.rwaMandates[0]}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <script define:vars={{ rwaAdvisoryHindi, rwaAdvisoryEng }}>
    const copyBtn = document.getElementById("btn-copy-notice");
    const copyBtnText = document.getElementById("copy-btn-text");
    const toast = document.getElementById("copy-toast");
    const headline = document.getElementById("advisory-headline");
    const body = document.getElementById("advisory-body");
    const bullets = document.getElementById("advisory-bullets");
    const btnHi = document.getElementById("btn-lang-hi");
    const btnEn = document.getElementById("btn-lang-en");

    let currentCard = rwaAdvisoryHindi.shareCardText;

    function renderHindi() {
      if (btnHi) btnHi.className = "px-4 py-1.5 rounded-full bg-[#ea580c] text-white font-semibold cursor-pointer transition-colors press-scale";
      if (btnEn) btnEn.className = "px-4 py-1.5 rounded-full bg-[#f7f9fa] text-[#595959] hover:text-[#262626] border border-[#e8e8e8] font-medium cursor-pointer transition-colors press-scale";
      if (headline) headline.innerText = rwaAdvisoryHindi.headline;
      if (body) body.innerText = rwaAdvisoryHindi.body;
      currentCard = rwaAdvisoryHindi.shareCardText;
      if (bullets) {
        bullets.innerHTML = rwaAdvisoryHindi.actionBulletPoints.map(p => `
          <div class="flex items-start gap-3 p-3.5 bg-[#f7f9fa] border border-[#e8e8e8] rounded-2xl text-xs text-[#262626]">
            <span class="text-[#ea580c] text-sm leading-none mt-0.5">⚠️</span>
            <span class="leading-relaxed">${p}</span>
          </div>
        `).join("");
      }
    }

    function renderEnglish() {
      if (btnEn) btnEn.className = "px-4 py-1.5 rounded-full bg-[#ea580c] text-white font-semibold cursor-pointer transition-colors press-scale";
      if (btnHi) btnHi.className = "px-4 py-1.5 rounded-full bg-[#f7f9fa] text-[#595959] hover:text-[#262626] border border-[#e8e8e8] font-medium cursor-pointer transition-colors press-scale";
      if (headline) headline.innerText = rwaAdvisoryEng.headline;
      if (body) body.innerText = rwaAdvisoryEng.body;
      currentCard = rwaAdvisoryEng.shareCardText;
      if (bullets) {
        bullets.innerHTML = rwaAdvisoryEng.actionBulletPoints.map(p => `
          <div class="flex items-start gap-3 p-3.5 bg-[#f7f9fa] border border-[#e8e8e8] rounded-2xl text-xs text-[#262626]">
            <span class="text-[#ea580c] text-sm leading-none mt-0.5">⚠️</span>
            <span class="leading-relaxed">${p}</span>
          </div>
        `).join("");
      }
    }

    btnHi?.addEventListener("click", renderHindi);
    btnEn?.addEventListener("click", renderEnglish);

    // Sync with global language switcher event
    window.addEventListener("airdelta:langchange", (e) => {
      const lang = e.detail?.lang;
      if (lang === "en") {
        renderEnglish();
      } else {
        renderHindi();
      }
    });

    copyBtn?.addEventListener("click", () => {
      navigator.clipboard.writeText(currentCard).then(() => {
        if (copyBtnText) copyBtnText.innerText = "Copied!";
        if (toast) {
          toast.classList.remove("hidden");
          setTimeout(() => {
            toast.classList.add("hidden");
            if (copyBtnText) copyBtnText.innerText = "Copy WhatsApp Notice";
          }, 3000);
        }
      });
    });
  </script>
</Layout>

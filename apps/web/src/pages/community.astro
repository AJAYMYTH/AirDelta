---
import Layout from "../layouts/Layout.astro";
import BadgePill from "../components/BadgePill.astro";
import { AirDataService } from "@airdelta/air-adapters";
import { getGrapStageForAqi, getAllGrapStages, AdvisoryService } from "@airdelta/schemas";

const airService = new AirDataService({ replayMode: true });
const snapshot = await airService.getAirSnapshot(28.6139, 77.2090);

const aqi = snapshot.indexValue || 385;
const activeGrapRule = getGrapStageForAqi(aqi);
const allStages = getAllGrapStages();

const advisoryService = new AdvisoryService();
const rwaAdvisory = advisoryService.generateAdvisory("rwa_residents", snapshot, "hi");
---

<Layout title="AirDelta — Multilingual Community Advisories">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a href="/" class="text-xs text-slate-400 hover:text-cyan-400">← Back to Today</a>
        <span class="text-xs text-slate-600">/</span>
        <span class="text-xs text-cyan-400 font-medium">Society & Campus Notices</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Multilingual Community Advisories</h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Authoritative, non-alarmist action cards for RWAs, schools, and offices · Delhi-NCR
          </p>
        </div>
        <div class="flex items-center gap-2">
          <BadgePill badge="forecast" />
          <span class="text-xs text-red-400 bg-red-950/60 border border-red-500/30 px-2.5 py-0.5 rounded-full font-mono font-bold">
            {activeGrapRule.stageName}
          </span>
        </div>
      </div>
    </div>

    <!-- Active Advisory Preview Card (WhatsApp / Telegram Shareable) -->
    <div class="p-6 sm:p-8 bg-gradient-to-br from-slate-900 via-slate-950 to-cyan-950/40 border border-slate-700/80 rounded-3xl shadow-2xl space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Target: RWA & Society Residents</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">Hindi (हिन्दी)</span>
          </div>
          <h2 class="text-xl font-bold text-slate-100 mt-1">{rwaAdvisory.headline}</h2>
        </div>

        <button
          type="button"
          onclick="navigator.clipboard.writeText(document.getElementById('share-text-box').innerText); alert('Copied shareable card to clipboard!');"
          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center gap-2 whitespace-nowrap self-start sm:self-auto"
        >
          <span>📋 Copy WhatsApp Notice</span>
        </button>
      </div>

      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{rwaAdvisory.body}</p>

      <!-- Action Bullet Points -->
      <div class="space-y-2.5">
        <span class="text-xs font-bold text-slate-200 uppercase tracking-wider block">Official Mandates & Protocol:</span>
        <div class="space-y-2">
          {rwaAdvisory.actionBulletPoints.map((point) => (
            <div class="flex items-start gap-3 p-3 bg-slate-900/60 border border-slate-800 rounded-xl text-xs text-slate-300">
              <span class="text-amber-400 text-sm leading-none mt-0.5">⚠️</span>
              <span>{point}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Hidden raw text box for clipboard copy -->
      <pre id="share-text-box" class="hidden">{rwaAdvisory.shareCardText}</pre>

      <div class="p-3.5 bg-slate-950/80 border border-slate-800 rounded-xl flex items-center justify-between text-xs text-slate-400">
        <span>Verified by CPCB NAQI Emergency Action Framework</span>
        <span class="font-mono text-cyan-400">Ready to forward on Telegram / WhatsApp</span>
      </div>
    </div>

    <!-- Official CAQM GRAP Policy Stages Matrix -->
    <div class="space-y-4">
      <div>
        <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block">Policy Reference</span>
        <h2 class="text-lg font-bold text-slate-100">CAQM Graded Response Action Plan (GRAP) Matrix</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {allStages.map((stage) => {
          const isActive = stage.stage === activeGrapRule.stage;
          const borderClass = isActive ? "border-red-500 ring-2 ring-red-500/30 bg-red-950/20" : "border-slate-800 bg-slate-900/60";

          return (
            <div class={`p-5 rounded-2xl border ${borderClass} space-y-3 flex flex-col justify-between`}>
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-200">{stage.stageName}</span>
                  {isActive && (
                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-red-600 text-white font-mono font-bold uppercase">
                      Active
                    </span>
                  )}
                </div>
                <span class="text-xs font-mono text-amber-400 font-semibold block">{stage.aqiThreshold}</span>
                <p class="text-[11px] text-slate-400 leading-snug">
                  <strong>School:</strong> {stage.schoolMandates[0]}
                </p>
                <p class="text-[11px] text-slate-400 leading-snug">
                  <strong>RWA:</strong> {stage.rwaMandates[0]}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- k-Anonymous Community Impact Tally -->
    <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-2xl space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider block">Community Impact Ledger</span>
          <h3 class="text-base font-bold text-slate-100 mt-0.5">Society Collective Smog Actions (Sector 14 RWA)</h3>
        </div>
        <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-mono">
          k-Anonymity Verified (k ≥ 5)
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
          <span class="text-xs text-slate-400 block">Participating Households</span>
          <span class="text-3xl font-extrabold text-slate-100 font-mono mt-1 block">8</span>
          <span class="text-[10px] text-emerald-400">k ≥ 5 anonymity threshold satisfied</span>
        </div>
        <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
          <span class="text-xs text-slate-400 block">Completed Plan B Actions</span>
          <span class="text-3xl font-extrabold text-cyan-400 font-mono mt-1 block">34</span>
          <span class="text-[10px] text-cyan-300">Walk shifts, N95 masks & exhaust active</span>
        </div>
        <div class="p-4 bg-slate-950/60 rounded-xl border border-slate-800">
          <span class="text-xs text-slate-400 block">Collective PM2.5 Prevented</span>
          <span class="text-3xl font-extrabold text-emerald-400 font-mono mt-1 block">1.5 g</span>
          <span class="text-[10px] text-emerald-300">Total toxic mass spared from lungs</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import delhiSmogData from "../../../../fixtures/delhi-smog-nov2026.json";

interface HourlyPoint {
  ts: string;
  hour: number;
  timeLabel: string;
  pm25: number;
  pm10: number;
  aqi: number;
  category: string;
  source: string;
  badge: string;
}

const hours: HourlyPoint[] = (delhiSmogData.forecast?.hourly || []).map((h: any) => {
  const d = new Date(h.ts);
  const hour = d.getUTCHours();
  return {
    ts: h.ts,
    hour,
    timeLabel: `${String(hour).padStart(2, "0")}:00`,
    pm25: Number(h.pm25),
    pm10: Number(h.pm10),
    aqi: Number(h.indexValue),
    category: String(h.category),
    source: hour <= 10 ? "cpcb" : "cams",
    badge: String(h.badge)
  };
});

const episodeMeta = delhiSmogData.episodeName || "Delhi-NCR Severe Smog";
---

<Layout title="AirDelta — Smog Replay Studio">
  <div class="space-y-8">
    <!-- Header -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">
              Deterministic Simulation
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
              {episodeMeta}
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Severe Smog Episode Replay
          </h1>
          <p class="text-sm text-slate-400 mt-1 max-w-2xl">
            Simulate and replay the severe post-Diwali Delhi NCR temperature inversion episode. Scrub across the day to observe how Plan B active interventions prevent critical respiratory dose spikes.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <button id="btn-play" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold text-xs rounded-xl shadow-lg shadow-cyan-500/20 transition-all flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M6.3 2.841A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"/>
            </svg>
            <span id="play-text">Play Replay</span>
          </button>
          <button id="btn-reset" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-xl border border-slate-700 transition-all">
            Reset
          </button>
        </div>
      </div>

      <!-- Scrubber Slider -->
      <div class="mt-8 space-y-3">
        <div class="flex justify-between items-center text-xs font-mono text-slate-400">
          <span id="label-time">Hour: 06:00 IST (Peak Morning Commute)</span>
          <span id="label-date">Nov 6, 2026 · Grid 28.61:77.21 (Delhi)</span>
        </div>
        <input 
          id="replay-slider" 
          type="range" 
          min="0" 
          max={hours.length > 0 ? hours.length - 1 : 0} 
          value="2" 
          class="w-full h-2.5 bg-slate-950 rounded-lg appearance-none cursor-pointer accent-cyan-400 border border-slate-700/60"
        />
        <div class="flex justify-between text-[11px] font-mono text-slate-500">
          <span>00:00 (Inversion)</span>
          <span>06:00 (Peak Smog)</span>
          <span>12:00 (Clearing)</span>
          <span>14:00 (Window)</span>
          <span>20:00 (Night Stagnation)</span>
        </div>
      </div>
    </div>

    <!-- Live Telemetry Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1: Ambient Conditions -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs uppercase font-mono text-slate-400">Ambient Air Quality</span>
          <span id="badge-provenance" class="px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-950 text-cyan-400 border border-cyan-800">
            [Measured]
          </span>
        </div>
        <div class="flex items-baseline gap-3">
          <span id="val-aqi" class="text-4xl font-extrabold text-red-400 font-mono">425</span>
          <span class="text-xs text-slate-400">CPCB NAQI</span>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-800/80 space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-400">PM2.5 Concentration:</span>
            <span id="val-pm25" class="font-mono text-slate-200">420 µg/m³</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">CPCB Category:</span>
            <span id="val-category" class="font-semibold uppercase text-red-400">Severe</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">CAQM GRAP Regulatory:</span>
            <span id="val-grap" class="font-mono text-red-400">Stage IV Active</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Plan A Exposure (Default Routine) -->
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs uppercase font-mono text-slate-400">Plan A: Normal Day</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-red-950 text-red-400 border border-red-800">
            Unprotected
          </span>
        </div>
        <div class="flex items-baseline gap-3">
          <span id="val-dose-a" class="text-4xl font-extrabold text-slate-100 font-mono">164.2</span>
          <span class="text-xs text-slate-400">µg inhaled</span>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-800/80 space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-400">Activity State:</span>
            <span id="val-state-a" class="text-slate-200">Roadside Two-Wheeler Commute</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Breathing Rate (VE):</span>
            <span class="font-mono text-slate-200">1.25 m³/h</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Filtration / Envelope:</span>
            <span class="text-red-400">None (F_micro = 1.15)</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Plan B Exposure (AirDelta Optimized) -->
      <div class="bg-slate-900/80 border border-cyan-800/40 rounded-2xl p-6 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-500/5 rounded-full blur-2xl pointer-events-none"></div>
        <div class="flex items-center justify-between mb-4">
          <span class="text-xs uppercase font-mono text-cyan-400">Plan B: AirDelta Guided</span>
          <span id="val-saved-percent" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800">
            -45.2% DOSE
          </span>
        </div>
        <div class="flex items-baseline gap-3">
          <span id="val-dose-b" class="text-4xl font-extrabold text-cyan-400 font-mono">89.9</span>
          <span class="text-xs text-slate-400">µg inhaled</span>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-800/80 space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-400">Intervention Mode:</span>
            <span id="val-state-b" class="text-emerald-400 font-medium">Metro AC + N95 (F_micro = 0.038)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Dose Difference:</span>
            <span id="val-saved-ug" class="font-mono text-emerald-400 font-semibold">-74.3 µg saved</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Carbon Impact:</span>
            <span class="font-mono text-cyan-300">-300 gCO₂e (Metro switch)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparative Hourly Timeline Visualization -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8">
      <h3 class="text-base font-bold text-white mb-2">Episode Smog Timeline (PM2.5 Profile)</h3>
      <p class="text-xs text-slate-400 mb-6">
        Discrete timeline points from CPCB Anand Vihar ITO and CAMS Forecast during the peak winter episode.
      </p>

      <div class="grid grid-cols-8 gap-3 h-36 items-end pt-4 pb-2 border-b border-slate-800">
        {hours.map((h: HourlyPoint, i: number) => {
          const heightPct = Math.min(100, Math.max(15, Math.round((h.pm25 / 450) * 100)));
          return (
            <div class="flex flex-col items-center gap-1 group relative">
              <div 
                id={`bar-${i}`}
                class="w-full bg-slate-800 rounded-t transition-all group-hover:bg-cyan-500/50 cursor-pointer"
                style={`height: ${heightPct}%`}
                title={`${h.timeLabel} · PM2.5: ${h.pm25} µg/m³`}
              ></div>
              <span class="text-[10px] font-mono text-slate-400">{h.timeLabel}</span>
            </div>
          );
        })}
      </div>
      <div class="flex justify-between text-xs text-slate-400 mt-3">
        <span>Bar height proportional to ambient PM2.5 concentration</span>
        <span class="font-mono text-red-400">Max AQI: 438 @ 03:00 IST</span>
      </div>
    </div>
  </div>

  <script define:vars={{ hours, episodeMeta }}>
    let currentIdx = 2;
    let isPlaying = false;
    let timer = null;

    const slider = document.getElementById("replay-slider");
    const playBtn = document.getElementById("btn-play");
    const resetBtn = document.getElementById("btn-reset");
    const playText = document.getElementById("play-text");

    const labelTime = document.getElementById("label-time");
    const valAqi = document.getElementById("val-aqi");
    const valPm25 = document.getElementById("val-pm25");
    const valCategory = document.getElementById("val-category");
    const valGrap = document.getElementById("val-grap");
    const valDoseA = document.getElementById("val-dose-a");
    const valDoseB = document.getElementById("val-dose-b");
    const valSavedPercent = document.getElementById("val-saved-percent");
    const valSavedUg = document.getElementById("val-saved-ug");
    const valStateA = document.getElementById("val-state-a");
    const valStateB = document.getElementById("val-state-b");
    const badgeProvenance = document.getElementById("badge-provenance");

    function updateView(idx) {
      if (!hours || hours.length === 0) return;
      currentIdx = idx;
      slider.value = idx;
      const data = hours[idx];

      labelTime.innerText = `Hour: ${data.timeLabel} IST`;
      valAqi.innerText = data.aqi;
      valPm25.innerText = `${data.pm25} µg/m³`;
      valCategory.innerText = data.category.toUpperCase();

      if (data.aqi >= 400) {
        valAqi.className = "text-4xl font-extrabold text-red-500 font-mono";
        valGrap.innerText = "Stage IV (Severe+)";
        valGrap.className = "font-mono text-red-400";
      } else if (data.aqi >= 300) {
        valAqi.className = "text-4xl font-extrabold text-red-400 font-mono";
        valGrap.innerText = "Stage III (Severe)";
        valGrap.className = "font-mono text-red-400";
      } else {
        valAqi.className = "text-4xl font-extrabold text-amber-400 font-mono";
        valGrap.innerText = "Stage II (Very Poor)";
        valGrap.className = "font-mono text-amber-400";
      }

      badgeProvenance.innerText = data.source === "cpcb" ? "[Measured: CPCB]" : "[Forecast: CAMS]";
      badgeProvenance.className = data.source === "cpcb" 
        ? "px-2 py-0.5 rounded text-[10px] font-mono bg-cyan-950 text-cyan-400 border border-cyan-800"
        : "px-2 py-0.5 rounded text-[10px] font-mono bg-violet-950 text-violet-400 border border-violet-800";

      // Cumulative dose simulation
      let accumDoseA = 0;
      let accumDoseB = 0;
      for (let i = 0; i <= idx; i++) {
        const h = hours[i];
        const isCommuteHour = h.hour >= 6 && h.hour <= 9;
        const pmA = isCommuteHour ? h.pm25 * 1.15 : h.pm25 * 0.75;
        accumDoseA += pmA * 0.45; // ~0.45 m3 breathing per step

        const pmB = isCommuteHour ? h.pm25 * 0.25 * (1 - 0.85) : h.pm25 * 0.20;
        accumDoseB += pmB * 0.45;
      }

      const diffUg = accumDoseA - accumDoseB;
      const pct = Math.max(0, Math.min(95, Math.round((diffUg / accumDoseA) * 100)));

      valDoseA.innerText = accumDoseA.toFixed(1);
      valDoseB.innerText = accumDoseB.toFixed(1);
      valSavedUg.innerText = `-${diffUg.toFixed(1)} µg saved`;
      valSavedPercent.innerText = `-${pct}% DOSE`;

      // State annotation
      if (data.hour >= 6 && data.hour <= 9) {
        valStateA.innerText = "Roadside Two-Wheeler Commute";
        valStateB.innerText = "Metro AC + Certified N95";
      } else if (data.hour >= 12 && data.hour <= 15) {
        valStateA.innerText = "Closed Stagnant Indoors";
        valStateB.innerText = "Ventilation Window Purge";
      } else if (data.hour >= 17 && data.hour <= 21) {
        valStateA.innerText = "Indoor Cooking without Exhaust";
        valStateB.innerText = "Active Exhaust Hood + Purifier High";
      } else {
        valStateA.innerText = "Unsealed Envelope Sleeping";
        valStateB.innerText = "Purified Sleeping Microenvironment";
      }

      // Highlight active timeline bar
      hours.forEach((_, i) => {
        const el = document.getElementById(`bar-${i}`);
        if (el) {
          if (i === idx) {
            el.className = "w-full bg-cyan-400 rounded-t shadow-lg shadow-cyan-500/50";
          } else {
            el.className = "w-full bg-slate-800 rounded-t hover:bg-slate-700";
          }
        }
      });
    }

    if (slider) {
      slider.addEventListener("input", (e) => {
        updateView(parseInt(e.target.value, 10));
      });
    }

    if (playBtn) {
      playBtn.addEventListener("click", () => {
        if (isPlaying) {
          clearInterval(timer);
          isPlaying = false;
          playText.innerText = "Play Replay";
        } else {
          isPlaying = true;
          playText.innerText = "Pause";
          timer = setInterval(() => {
            currentIdx = (currentIdx + 1) % hours.length;
            updateView(currentIdx);
          }, 1500);
        }
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (isPlaying) {
          clearInterval(timer);
          isPlaying = false;
          playText.innerText = "Play Replay";
        }
        updateView(2);
      });
    }

    // Initialize at 06:00 peak
    updateView(2);
  </script>
</Layout>

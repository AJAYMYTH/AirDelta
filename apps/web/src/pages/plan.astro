---
import Layout from "../layouts/Layout.astro";
import BadgePill from "../components/BadgePill.astro";
import { AirDataService } from "@airdelta/air-adapters";
import { optimizeHouseholdPlan, TemplateFallbackService } from "@airdelta/engine";

const airService = new AirDataService({ replayMode: true });
const snapshot = await airService.getAirSnapshot(28.6139, 77.2090);
const forecast = await airService.getAirForecast(28.6139, 77.2090);

const profile = {
  cityCode: "DELHI",
  gridCell: "28.61:77.21",
  lang: "en",
  budgetBand: "low" as const,
  cooksIndoors: true,
  hasExhaust: false,
  hasPurifier: false,
  members: [
    { id: "m-1", ageBand: "adult" as const, cautionMode: false, label: "Parent (Adult)" },
    { id: "m-2", ageBand: "child" as const, cautionMode: true, label: "Child (6yo)" }
  ],
  routines: [
    {
      id: "r-walk",
      memberId: "m-1",
      kind: "walk" as const,
      startHour: 7,
      durationMinutes: 45,
      isIndoor: false,
      maskUsed: false
    },
    {
      id: "r-commute",
      memberId: "m-1",
      kind: "commute" as const,
      mode: "two_wheeler" as const,
      startHour: 9,
      durationMinutes: 45,
      isIndoor: false,
      maskUsed: false
    },
    {
      id: "r-cook",
      memberId: "m-1",
      kind: "cooking" as const,
      startHour: 19,
      durationMinutes: 60,
      isIndoor: true,
      maskUsed: false
    }
  ]
};

const engineResult = optimizeHouseholdPlan(profile, snapshot, forecast);
const fallbackService = new TemplateFallbackService();
const narrative = fallbackService.generateTemplateNarration(
  "en",
  snapshot,
  engineResult.planA,
  engineResult.planB
);

const { planA, planB, emissions, assumptions } = engineResult;
---

<Layout title="AirDelta — Plan A vs Plan B Optimizer">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header Title -->
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a href="/" class="text-xs text-slate-400 hover:text-cyan-400">← Back to Today</a>
        <span class="text-xs text-slate-600">/</span>
        <span class="text-xs text-cyan-400 font-medium">Household Exposure Optimizer</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">Plan A vs Plan B Exposure Ledger</h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            Deterministic dose simulation based on actual physical routine segments · Delhi-NCR (ITO)
          </p>
        </div>
        <div class="flex items-center gap-2">
          <BadgePill badge="modelled" />
          <span class="text-xs text-slate-400 font-mono">Engine v1.0.0</span>
        </div>
      </div>
    </div>

    <!-- AI & Grounded Narrative Banner -->
    <div class="p-5 bg-gradient-to-r from-cyan-950/70 via-slate-900 to-slate-950 border border-cyan-500/30 rounded-2xl shadow-xl">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Grounded Health Guidance
        </span>
        <span class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono">
          Source: {narrative.source === "llm" ? "Gemini 2.0 Flash (Verified)" : "Deterministic Template"}
        </span>
      </div>
      <h2 class="text-lg font-bold text-slate-100">{narrative.headline}</h2>
      <p class="text-xs sm:text-sm text-slate-300 mt-1.5 leading-relaxed">{narrative.body}</p>
    </div>

    <!-- Comparative Dose Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Plan A (Normal Day) -->
      <div class="p-6 bg-slate-900/70 border border-slate-800 rounded-2xl space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-xs uppercase font-semibold text-slate-400 tracking-wider">Plan A</span>
            <h3 class="text-lg font-bold text-slate-200">Normal Routine</h3>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-red-950/60 text-red-400 border border-red-800/40">
            Unmitigated
          </span>
        </div>

        <div class="py-4 border-y border-slate-800/80">
          <span class="text-xs text-slate-400 block">Total Inhaled PM2.5 Dose</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span class="text-4xl font-extrabold text-slate-100 font-mono">{planA.totalDoseUg.mid}</span>
            <span class="text-sm font-semibold text-slate-400">µg / day</span>
          </div>
          <span class="text-[11px] text-slate-400 font-mono mt-1 block">
            Uncertainty range: {planA.totalDoseUg.low} – {planA.totalDoseUg.high} µg
          </span>
        </div>

        <!-- Segments breakdown -->
        <div class="space-y-2">
          <span class="text-xs font-semibold text-slate-400 block">Exposure by Segment:</span>
          {planA.segments.map((seg) => (
            <div class="flex items-center justify-between text-xs p-2.5 bg-slate-950/60 rounded-lg border border-slate-800/60">
              <span class="capitalize text-slate-300 font-medium">{seg.kind.replace("_", " ")}</span>
              <span class="font-mono text-slate-400">{seg.doseUg} µg</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Plan B (Optimized Day) -->
      <div class="p-6 bg-gradient-to-br from-emerald-950/40 via-slate-900 to-slate-950 border border-emerald-500/40 rounded-2xl space-y-4 shadow-xl">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-xs uppercase font-semibold text-emerald-400 tracking-wider">Plan B</span>
            <h3 class="text-lg font-bold text-white">Optimized Day</h3>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-mono bg-emerald-950 text-emerald-300 border border-emerald-500/40">
            -{planB.netSavingPercent}% Inhaled Dose
          </span>
        </div>

        <div class="py-4 border-y border-emerald-800/30">
          <span class="text-xs text-slate-400 block">Optimized Inhaled PM2.5 Dose</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span class="text-4xl font-extrabold text-emerald-400 font-mono">{planB.totalDoseUg.mid}</span>
            <span class="text-sm font-semibold text-emerald-300">µg / day</span>
          </div>
          <span class="text-[11px] text-emerald-300/80 font-mono mt-1 block">
            Net Saving: <span class="font-bold text-emerald-400">-{planB.netSavingUg} µg</span> ({planB.netSavingPercent}% reduction)
          </span>
        </div>

        <!-- Recommended Changes -->
        <div class="space-y-2.5">
          <span class="text-xs font-semibold text-slate-300 block">Top Plan B Interventions:</span>
          {planB.changes.map((c) => (
            <div class="p-3 bg-slate-950/80 rounded-xl border border-emerald-500/20 space-y-1">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-emerald-300">{c.title}</span>
                <span class="text-xs font-mono font-bold text-emerald-400">{c.deltaUg} µg</span>
              </div>
              <p class="text-[11px] text-slate-400 leading-snug">{c.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Dual Ledgers: Avoided Emissions & Trade-off Analysis -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Emissions Ledger -->
      <div class="p-5 bg-slate-900/60 border border-slate-800 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-200">Avoided Transport Emissions</h3>
          <BadgePill badge={emissions.badge} />
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-cyan-400 font-mono">
            {Math.abs(emissions.deltaGramsCo2e)}
          </span>
          <span class="text-xs font-medium text-slate-400">g CO₂e avoided per day</span>
        </div>
        <p class="text-xs text-slate-400">
          Shifting from two-wheeler to electric Metro reduces tailpipe greenhouse gas emissions while removing roadside particulate exposure.
        </p>
      </div>

      <!-- Trade-off Card -->
      <div class="p-5 bg-slate-900/60 border border-slate-800 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-amber-300">⚖️ Exposure vs Emissions Trade-off</h3>
          <span class="text-[10px] px-2 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800/40">Severe Day Warning</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          <strong>Cycling vs Metro on a 380+ AQI Day:</strong> While cycling produces 0 g emissions, the heavy breathing exertion (<span class="font-mono text-cyan-300">2.1 m³/h</span>) directly in ambient roadside smog triples your inhaled PM2.5 dose. On Severe days, public Metro transit is medically safer.
        </p>
      </div>
    </div>

    <!-- Assumptions Accordion -->
    <div class="p-5 bg-slate-900/40 border border-slate-800/80 rounded-2xl space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-semibold text-slate-300">Constants & Literature Assumptions Used</h3>
        <a href="/method" class="text-xs text-cyan-400 hover:underline">Full Registry →</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {assumptions.map((item) => (
          <span class="text-[11px] font-mono px-2 py-1 rounded bg-slate-950 text-slate-400 border border-slate-800">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
</Layout>

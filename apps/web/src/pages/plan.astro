---
import Layout from "../layouts/Layout.astro";
import BadgePill from "../components/BadgePill.astro";
import { AirDataService } from "@airdelta/air-adapters";
import { optimizeHouseholdPlan, TemplateFallbackService } from "@airdelta/engine";
import { 
  Leaf, 
  AlertCircle, 
  ArrowRight, 
  Sparkles, 
  Check 
} from "lucide-astro";

const airService = new AirDataService({ replayMode: true });
const snapshot = await airService.getAirSnapshot(28.6139, 77.2090);
const forecast = await airService.getAirForecast(28.6139, 77.2090);

const profile = {
  cityCode: "DELHI",
  gridCell: "28.61:77.21",
  lang: "en",
  budgetBand: "low" as const,
  cooksIndoors: true,
  hasExhaust: false,
  hasPurifier: false,
  members: [
    { id: "m-1", ageBand: "adult" as const, cautionMode: false, label: "Parent (Adult)" },
    { id: "m-2", ageBand: "child" as const, cautionMode: true, label: "Child (6yo)" }
  ],
  routines: [
    {
      id: "r-walk",
      memberId: "m-1",
      kind: "walk" as const,
      startHour: 7,
      durationMinutes: 45,
      isIndoor: false,
      maskUsed: false
    },
    {
      id: "r-commute",
      memberId: "m-1",
      kind: "commute" as const,
      mode: "two_wheeler" as const,
      startHour: 9,
      durationMinutes: 45,
      isIndoor: false,
      maskUsed: false
    },
    {
      id: "r-cook",
      memberId: "m-1",
      kind: "cooking" as const,
      startHour: 19,
      durationMinutes: 60,
      isIndoor: true,
      maskUsed: false
    }
  ]
};

const engineResult = optimizeHouseholdPlan(profile, snapshot, forecast);
const fallbackService = new TemplateFallbackService();
const narrative = fallbackService.generateTemplateNarration(
  "en",
  snapshot,
  engineResult.planA,
  engineResult.planB
);

const { planA, planB, emissions, assumptions } = engineResult;
---

<Layout title="AirDelta — Plan A vs Plan B Optimizer">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header Title -->
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <a href="/" class="text-xs font-semibold text-[#8c8c8c] hover:text-[#ea580c] transition-colors">← Back to Today</a>
        <span class="text-xs text-[#d9d9d9]">/</span>
        <span class="text-xs text-[#ea580c] font-semibold" data-i18n="planTitle">Household Exposure Optimizer</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#262626]">Plan A vs Plan B Exposure Ledger</h1>
          <p class="text-xs sm:text-sm text-[#595959] mt-1">
            Deterministic dose simulation based on actual physical routine segments · Delhi-NCR (ITO Grid)
          </p>
        </div>
        <div class="flex items-center gap-2">
          <BadgePill badge="modelled" />
          <span class="text-xs text-[#595959] font-mono bg-[#f7f9fa] border border-[#e8e8e8] px-2.5 py-1 rounded-full">Engine v1.0.0</span>
        </div>
      </div>
    </div>

    <!-- AI & Grounded Narrative Banner (DJI Showroom Alert Card) -->
    <div class="p-6 bg-[#fff7ed] border border-[#fed7aa] rounded-2xl shadow-xs stagger-card">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[11px] font-bold text-[#ea580c] uppercase tracking-wider flex items-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5 text-[#ea580c]" /> Grounded Health Guidance
        </span>
        <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-white text-[#595959] font-mono border border-[#fed7aa]">
          Source: {narrative.source === "llm" ? "Gemini 2.0 Flash (Verified)" : "Deterministic Template"}
        </span>
      </div>
      <h2 class="text-lg font-bold text-[#262626]">{narrative.headline}</h2>
      <p class="text-xs sm:text-sm text-[#595959] mt-1.5 leading-relaxed">{narrative.body}</p>
    </div>

    <!-- Comparative Dose Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 stagger-card">
      <!-- Plan A (Normal Day - Showroom Neutral Baseline) -->
      <div class="p-6 bg-[#f7f9fa] border border-[#e8e8e8] rounded-3xl space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] uppercase font-bold text-[#8c8c8c] tracking-wider" data-i18n="planA">Plan A</span>
            <h3 class="text-lg font-bold text-[#262626]">Normal Routine</h3>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-mono font-semibold bg-[#fee2e2] text-[#dc2626] border border-[#fca5a5]">
            Unmitigated
          </span>
        </div>

        <div class="py-4 border-y border-[#e8e8e8]">
          <span class="text-xs text-[#595959] block">Total Inhaled PM2.5 Dose</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span class="text-4xl font-extrabold text-[#262626] font-mono tracking-tight">{planA.totalDoseUg.mid}</span>
            <span class="text-sm font-semibold text-[#8c8c8c]">µg / day</span>
          </div>
          <span class="text-[11px] text-[#8c8c8c] font-mono mt-1 block">
            Uncertainty range: {planA.totalDoseUg.low} – {planA.totalDoseUg.high} µg
          </span>
        </div>

        <!-- Segments breakdown -->
        <div class="space-y-2">
          <span class="text-xs font-bold text-[#595959] block">Exposure by Routine Segment:</span>
          {planA.segments.map((seg) => (
            <div class="flex items-center justify-between text-xs p-3 bg-white rounded-xl border border-[#e8e8e8]">
              <span class="capitalize text-[#262626] font-semibold">{seg.kind.replace("_", " ")}</span>
              <span class="font-mono text-[#595959] font-medium">{seg.doseUg} µg</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Plan B (Optimized Day - Flagship Showroom Highlight Card) -->
      <div class="p-6 bg-white border-2 border-[#ea580c] rounded-3xl space-y-4 shadow-sm relative overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] uppercase font-bold text-[#ea580c] tracking-wider" data-i18n="planB">Plan B · Flagship</span>
            <h3 class="text-lg font-bold text-[#262626]">AirDelta Guided Day</h3>
          </div>
          <span id="plan-b-saving-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#fff7ed] text-[#ea580c] border border-[#fed7aa] transition-all">
            -{planB.netSavingPercent}% Inhaled Dose
          </span>
        </div>

        <div class="py-4 border-y border-[#fed7aa]/60">
          <span class="text-xs text-[#595959] block">Optimized Inhaled PM2.5 Dose</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="plan-b-dose-display" class="text-4xl font-extrabold text-[#ea580c] font-mono tracking-tight">{planB.totalDoseUg.mid}</span>
            <span class="text-sm font-semibold text-[#ea580c]">µg / day</span>
          </div>
          <span class="text-[11px] text-[#595959] font-mono mt-1 block">
            Net Saving: <span id="plan-b-net-ug" class="font-bold text-[#ea580c]">-{planB.netSavingUg} µg</span> (<span id="plan-b-net-pct">{planB.netSavingPercent}%</span> reduction)
          </span>
        </div>

        <!-- Recommended Changes (Interactive Intervention Toggle) -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-[#262626] block">Interactive Interventions:</span>
            <span class="text-[10px] text-[#8c8c8c] font-mono">Click to toggle impact</span>
          </div>
          {planB.changes.map((c, i) => (
            <div 
              class="intervention-card p-3.5 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] space-y-1 hover:border-[#ea580c] transition-all cursor-pointer press-scale" 
              data-delta={c.deltaUg} 
              data-index={i}
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="intervention-check w-4 h-4 rounded-md bg-[#ea580c] text-white flex items-center justify-center text-[10px]">
                    <Check class="w-3 h-3" />
                  </div>
                  <span class="text-xs font-bold text-[#262626]">{c.title}</span>
                </div>
                <span class="text-xs font-mono font-bold text-[#ea580c]">{c.deltaUg} µg</span>
              </div>
              <p class="text-[11px] text-[#595959] leading-snug pl-6">{c.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Dual Ledgers: Avoided Emissions & Trade-off Analysis -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 stagger-card">
      <!-- Emissions Ledger -->
      <div class="p-6 bg-white border border-[#e8e8e8] rounded-3xl space-y-3 shadow-xs">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Leaf class="w-4 h-4 text-[#15803d]" />
            <h3 class="text-sm font-bold text-[#262626]" data-i18n="co2eAvoided">Avoided Transport Emissions</h3>
          </div>
          <BadgePill badge={emissions.badge} />
        </div>
        <div class="flex items-baseline gap-2">
          <span class="text-3xl font-extrabold text-[#ea580c] font-mono tracking-tight">
            {Math.abs(emissions.deltaGramsCo2e)}
          </span>
          <span class="text-xs font-semibold text-[#595959]">g CO₂e avoided per day</span>
        </div>
        <p class="text-xs text-[#595959] leading-relaxed">
          Shifting from two-wheeler to electric Metro reduces tailpipe greenhouse gas emissions while removing roadside particulate exposure.
        </p>
      </div>

      <!-- Trade-off Card -->
      <div class="p-6 bg-white border border-[#e8e8e8] rounded-3xl space-y-3 shadow-xs">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <AlertCircle class="w-4 h-4 text-[#ea580c]" />
            <h3 class="text-sm font-bold text-[#262626]">Exposure vs Emissions Trade-off</h3>
          </div>
          <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-[#fef3c7] text-[#92400e] border border-[#fde68a] font-semibold">
            Severe Day Warning
          </span>
        </div>
        <p class="text-xs text-[#595959] leading-relaxed">
          <strong class="text-[#262626]">Cycling vs Metro on a 380+ AQI Day:</strong> While cycling produces 0 g tailpipe emissions, heavy exertion breathing (<span class="font-mono font-semibold text-[#ea580c]">2.1 m³/h</span>) directly in ambient roadside smog triples your inhaled PM2.5 dose. On Severe days, public Metro transit is medically safer.
        </p>
      </div>
    </div>

    <!-- Assumptions Accordion -->
    <div class="p-6 bg-[#f7f9fa] border border-[#e8e8e8] rounded-3xl space-y-3 stagger-card">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-bold text-[#262626]" data-i18n="assumptionsUsed">Constants & Literature Assumptions Used</h3>
        <a href="/method" class="text-xs text-[#ea580c] font-semibold hover:underline flex items-center gap-1">
          <span>Full Registry</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {assumptions.map((item) => (
          <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-white text-[#595959] border border-[#e8e8e8]">
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>

  <script define:vars={{ baseDoseA: planA.totalDoseUg.mid, baseDoseB: planB.totalDoseUg.mid }}>
    // Interactive Plan B Interventions Dynamic Toggle
    let activeSavings = {};
    const cards = document.querySelectorAll(".intervention-card");
    const doseDisplay = document.getElementById("plan-b-dose-display");
    const netUgDisplay = document.getElementById("plan-b-net-ug");
    const netPctDisplay = document.getElementById("plan-b-net-pct");
    const badge = document.getElementById("plan-b-saving-badge");

    cards.forEach((card) => {
      const idx = card.getAttribute("data-index");
      const delta = Math.abs(parseFloat(card.getAttribute("data-delta") || "0"));
      activeSavings[idx] = delta;

      card.addEventListener("click", () => {
        const checkIcon = card.querySelector(".intervention-check");
        if (activeSavings[idx] > 0) {
          // Deactivate
          activeSavings[idx] = 0;
          card.classList.add("opacity-50", "bg-white");
          card.classList.remove("bg-[#f7f9fa]");
          if (checkIcon) {
            checkIcon.classList.remove("bg-[#ea580c]");
            checkIcon.classList.add("bg-[#d9d9d9]");
          }
        } else {
          // Activate
          activeSavings[idx] = delta;
          card.classList.remove("opacity-50", "bg-white");
          card.classList.add("bg-[#f7f9fa]");
          if (checkIcon) {
            checkIcon.classList.add("bg-[#ea580c]");
            checkIcon.classList.remove("bg-[#d9d9d9]");
          }
        }

        // Recalculate
        const totalSaved = Object.values(activeSavings).reduce((a, b) => a + b, 0);
        const currentDose = Math.max(10, baseDoseA - totalSaved);
        const currentPct = Math.round((totalSaved / baseDoseA) * 100);

        if (doseDisplay) doseDisplay.innerText = currentDose.toFixed(1);
        if (netUgDisplay) netUgDisplay.innerText = `-${totalSaved.toFixed(1)} µg`;
        if (netPctDisplay) netPctDisplay.innerText = `${currentPct}%`;
        if (badge) badge.innerText = `-${currentPct}% Inhaled Dose`;
      });
    });
  </script>
</Layout>

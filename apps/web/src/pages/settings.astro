---
import Layout from "../layouts/Layout.astro";
import { getAllLanguages } from "@airdelta/i18n";
import Languages from "lucide-astro/Languages";
import Download from "lucide-astro/Download";
import Trash2 from "lucide-astro/Trash2";
import Send from "lucide-astro/Send";
import Lock from "lucide-astro/Lock";
import Check from "lucide-astro/Check";
import ExternalLink from "lucide-astro/ExternalLink";
import Database from "lucide-astro/Database";

const languages = getAllLanguages();
---

<Layout title="AirDelta — Settings & Privacy">
  <div class="max-w-3xl mx-auto space-y-8">
    <!-- Header -->
    <div class="bg-white border border-[#e8e8e8] rounded-3xl p-4 sm:p-6 md:p-8 shadow-xs stagger-card">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="px-3 py-0.5 rounded-full text-[11px] font-bold bg-[#fff7ed] text-[#ea580c] border border-[#fed7aa] flex items-center gap-1.5">
          <Languages class="w-3.5 h-3.5" />
          <span data-i18n="userPrefs">User Preferences</span>
        </span>
        <span class="px-3 py-0.5 rounded-full text-[11px] font-mono font-semibold bg-[#f7f9fa] text-[#595959] border border-[#e8e8e8]" data-i18n="clientSideStorage">
          Client-Side Storage
        </span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#262626] mb-1" data-i18n="settingsTitle">
        Settings & Privacy
      </h1>
      <p class="text-xs sm:text-sm text-[#595959] leading-relaxed" data-i18n="settingsSubtitle">
        Manage your regional language preferences, audit notifications, and control your household data privacy.
      </p>
    </div>

    <!-- Language Selector -->
    <div class="bg-white border border-[#e8e8e8] rounded-3xl p-4 sm:p-6 md:p-8 shadow-xs stagger-card">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
        <h2 class="text-lg font-bold text-[#171717]" data-i18n="chooseYourLang">Choose Your Language</h2>
        <span class="text-xs text-[#ea580c] font-mono font-semibold" data-i18n="languagesSupported">13 Supported</span>
      </div>
      <p class="text-xs text-[#595959] mb-6 leading-relaxed" data-i18n="langDesc">
        Select from 12 official Indian languages. All explanations, community notices, and photo audit recommendations will be rendered in your chosen language.
      </p>

      <div class="grid grid-cols-1 min-[380px]:grid-cols-2 sm:grid-cols-3 gap-3">
        {languages.map((l) => (
          <button 
            type="button" 
            data-lang={l.code}
            class="btn-lang-choice text-left p-4 rounded-2xl border border-[#e8e8e8] bg-[#f7f9fa] hover:border-[#ea580c] transition-all flex flex-col gap-1 cursor-pointer press-scale"
          >
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-[#262626]">{l.nativeName}</span>
              <Check class="lang-grid-check w-3.5 h-3.5 text-[#ea580c] hidden" />
            </div>
            <span class="text-[11px] text-[#595959] font-medium">{l.name} ({l.code})</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Notification Channels -->
    <div class="bg-white border border-[#e8e8e8] rounded-3xl p-4 sm:p-6 md:p-8 shadow-xs stagger-card">
      <h2 class="text-lg font-bold text-[#262626] mb-1" data-i18n="morningAlertsHeading">Morning Alerts & Telegram Bot</h2>
      <p class="text-xs text-[#595959] mb-6 leading-relaxed" data-i18n="morningAlertsDesc">
        AirDelta pushes deterministic morning briefs at 07:00 IST directly via Telegram Bot to avoid commercial SMS costs.
      </p>

      <div class="p-4 sm:p-5 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="font-bold text-[#262626] text-sm flex items-center gap-1.5">
            <Send class="w-4 h-4 text-[#ea580c]" />
            <span data-i18n="telegramChannel">Telegram Bot Channel</span>
          </div>
          <div class="text-xs text-[#595959] mt-0.5 leading-relaxed" data-i18n="telegramDesc">Free 07:00 proactive morning alerts, quick photo audits, and routine checks.</div>
        </div>
        <a 
          href="https://t.me/airdeltabot" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-action w-full sm:w-auto justify-center px-6 py-2.5 bg-[#ea580c] hover:bg-[#c2410c] text-white font-bold text-xs rounded-full shadow-sm transition-all text-center whitespace-nowrap flex items-center gap-1.5 cursor-pointer press-scale"
        >
          <span data-i18n="openBotBtn">Open @airdeltabot</span>
          <ExternalLink class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Data Sovereignty & Zero PII Guarantee -->
    <div class="bg-white border border-[#e8e8e8] rounded-3xl p-4 sm:p-6 md:p-8 shadow-xs stagger-card">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-3 py-0.5 rounded-full text-[10px] font-mono font-bold bg-[#dcfce7] text-[#15803d] border border-[#86efac] flex items-center gap-1.5">
          <Lock class="w-3 h-3" />
          <span data-i18n="privacyFirstBadge">Privacy First · Zero Tracking</span>
        </span>
      </div>
      <h2 class="text-lg font-bold text-[#171717] mb-1" data-i18n="savedDataHeading">Your Saved Data Controls</h2>
      <p class="text-xs text-[#595959] mb-6 leading-relaxed" data-i18n="savedDataDesc">
        AirDelta never collects or stores names, emails, phone numbers, or exact street addresses. Coordinates are snapped to coarse ~1.1 km spatial cells. Plans are automatically pruned after 30 days.
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 sm:gap-4">
        <button 
          id="btn-export" 
          type="button"
          class="btn-action w-full sm:w-auto justify-center px-6 py-2.5 bg-white hover:bg-[#f7f9fa] text-[#262626] text-xs font-bold rounded-full border border-[#d9d9d9] shadow-xs transition-all flex items-center gap-2 cursor-pointer press-scale"
        >
          <Download class="w-4 h-4 text-[#ea580c]" />
          <span data-i18n="exportJsonBtn">Export Data (JSON)</span>
        </button>

        <button 
          id="btn-purge" 
          type="button"
          class="btn-action w-full sm:w-auto justify-center px-6 py-2.5 bg-[#fee2e2] hover:bg-[#fecaca] text-[#dc2626] text-xs font-bold rounded-full border border-[#fca5a5] shadow-xs transition-all flex items-center gap-2 cursor-pointer press-scale"
        >
          <Trash2 class="w-4 h-4 text-[#dc2626]" />
          <span data-i18n="purgeDataBtn">Purge All Local Data</span>
        </button>
      </div>

      <div id="status-toast" class="hidden mt-4 p-4 bg-[#dcfce7] border border-[#86efac] rounded-2xl text-[#15803d] text-xs font-semibold flex items-center gap-2">
        <Check class="w-4 h-4 text-[#15803d]" />
        <span id="toast-text"></span>
      </div>
    </div>

    <!-- Used Resources & Data Sources -->
    <div class="bg-white border border-[#e8e8e8] rounded-3xl p-4 sm:p-6 md:p-8 shadow-xs stagger-card">
      <div class="flex items-center gap-2 mb-1">
        <Database class="w-4 h-4 text-[#ea580c] shrink-0" aria-hidden="true" />
        <h2 class="text-lg font-bold text-[#171717]" data-i18n="usedResourcesHeading">Used Resources &amp; Data Sources</h2>
      </div>
      <p class="text-xs text-[#595959] mb-5 leading-relaxed" data-i18n="usedResourcesDesc">
        AirDelta combines open ground-station air monitoring, weather dispersion models, and official Indian air-quality standards.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] space-y-1">
          <div class="flex items-center justify-between gap-2">
            <span class="font-bold text-[#171717]">Open-Meteo Air Quality</span>
            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#fff7ed] text-[#ea580c] border border-[#fed7aa]">Primary Live AQI</span>
          </div>
          <p class="text-[#595959] leading-relaxed">Real-time global &amp; live-location AQI, PM2.5, PM10, gases, and 72-hour atmospheric dispersion forecasts.</p>
        </div>

        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] space-y-1">
          <div class="flex items-center justify-between gap-2">
            <span class="font-bold text-[#171717]">OpenAQ v3</span>
            <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-white text-[#525252] border border-[#e5e5e5]">Ground Stations</span>
          </div>
          <p class="text-[#595959] leading-relaxed">Open-source ground monitoring stations (CPCB, DPCC, MPCB, UPPCB, BSPCB) within 25 km.</p>
        </div>

        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] space-y-1">
          <div class="flex items-center justify-between gap-2">
            <span class="font-bold text-[#171717]">CPCB NAQI &amp; CAQM GRAP</span>
            <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-white text-[#525252] border border-[#e5e5e5]">Official Standards</span>
          </div>
          <p class="text-[#595959] leading-relaxed">Government of India National Air Quality Index categories and Graded Response Action Plan stages.</p>
        </div>

        <div class="p-4 bg-[#f7f9fa] rounded-2xl border border-[#e8e8e8] space-y-1">
          <div class="flex items-center justify-between gap-2">
            <span class="font-bold text-[#171717]">Google Gemini &amp; Exposure Physics</span>
            <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-white text-[#525252] border border-[#e5e5e5]">AI + Engine</span>
          </div>
          <p class="text-[#595959] leading-relaxed">Deterministic exposure models compute every dose; Gemini provides 13-language summaries and room photo checks.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLElement>(".btn-lang-choice");
    const exportBtn = document.getElementById("btn-export");
    const purgeBtn = document.getElementById("btn-purge");
    const toast = document.getElementById("status-toast");
    const toastText = document.getElementById("toast-text");

    function highlightActiveLang(currentLang: string) {
      buttons.forEach((btn) => {
        const code = btn.getAttribute("data-lang");
        const check = btn.querySelector(".lang-grid-check");
        if (code === currentLang) {
          btn.classList.add("border-2", "border-[#ea580c]", "bg-[#fff7ed]", "shadow-xs");
          btn.classList.remove("border-[#e8e8e8]", "bg-[#f7f9fa]");
          if (check) check.classList.remove("hidden");
        } else {
          btn.classList.remove("border-2", "border-[#ea580c]", "bg-[#fff7ed]", "shadow-xs");
          btn.classList.add("border-[#e8e8e8]", "bg-[#f7f9fa]");
          if (check) check.classList.add("hidden");
        }
      });
    }

    // Initialize current lang
    const initialLang = localStorage.getItem("airdelta_lang") || "en";
    highlightActiveLang(initialLang);

    // Language selection click
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const code = btn.getAttribute("data-lang") || "en";
        highlightActiveLang(code);
        
        // Invoke global runtime
        if (window.AirDeltaRuntime) {
          window.AirDeltaRuntime.applyLanguage(code);
        }

        if (toast && toastText) {
          toastText.innerText = `Language set to ${btn.querySelector("span")?.innerText || code}. Changes applied dynamically!`;
          toast.classList.remove("hidden");
          setTimeout(() => toast.classList.add("hidden"), 3000);
        }
      });
    });

    if (exportBtn) {
      exportBtn.addEventListener("click", () => {
        const payload = {
          exportedAt: new Date().toISOString(),
          householdProfile: localStorage.getItem("airdelta_household") || "Default 2-Person Delhi Household",
          activeLang: localStorage.getItem("airdelta_lang") || "en",
          version: "1.0.0",
          engineConstants: "2026-11-a"
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `airdelta-export-${new Date().toISOString().split("T")[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);

        if (toast && toastText) {
          toastText.innerText = "Household data exported successfully (JSON format).";
          toast.classList.remove("hidden");
          setTimeout(() => toast.classList.add("hidden"), 3000);
        }
      });
    }

    if (purgeBtn) {
      purgeBtn.addEventListener("click", () => {
        if (confirm("Are you sure you want to purge all local household data and plans?")) {
          localStorage.clear();
          if (toast && toastText) {
            toastText.innerText = "All local data has been purged successfully.";
            toast.classList.remove("hidden");
            setTimeout(() => toast.classList.add("hidden"), 3000);
          }
        }
      });
    }
  </script>
</Layout>

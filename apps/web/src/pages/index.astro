---
import Layout from "../layouts/Layout.astro";
import BadgePill from "../components/BadgePill.astro";
import ForecastStrip from "../components/ForecastStrip.astro";
import { AirDataService } from "@airdelta/air-adapters";

const airService = new AirDataService({ replayMode: true });
// Default Delhi (Connaught Place / ITO)
const snapshot = await airService.getAirSnapshot(28.6139, 77.2090);
const forecast = await airService.getAirForecast(28.6139, 77.2090);

const aqi = snapshot.indexValue || 385;
const isSevere = aqi > 400;
const isVeryPoor = aqi > 300 && aqi <= 400;
const aqiColor = isSevere ? "text-red-500" : isVeryPoor ? "text-amber-500" : "text-emerald-400";
const aqiBgGradient = isSevere
  ? "from-red-950/40 via-slate-900 to-slate-950 border-red-500/30"
  : "from-amber-950/40 via-slate-900 to-slate-950 border-amber-500/30";
---

<Layout title="AirDelta — Today's Air Snapshot">
  <div class="space-y-6">
    <!-- CAQM GRAP Status Alert Banner -->
    <div class="p-3.5 bg-gradient-to-r from-red-950/70 to-slate-900 border border-red-500/40 rounded-xl flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 rounded bg-red-600/30 text-red-400 text-xs font-bold border border-red-500/40 font-mono">
          GRAP STAGE III
        </span>
        <p class="text-xs sm:text-sm text-slate-200">
          Severe Air Quality measures active across Delhi-NCR. Non-essential construction prohibited.
        </p>
      </div>
      <a href="/advisory" class="hidden sm:inline-block text-xs text-red-400 hover:underline">View Rules →</a>
    </div>

    <!-- Main Air Quality Hero Card -->
    <div class={`p-6 sm:p-8 rounded-3xl border bg-gradient-to-br ${aqiBgGradient} shadow-2xl`}>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-white">Delhi-NCR Central (ITO)</h1>
            <BadgePill badge={snapshot.badge} />
          </div>
          <p class="text-xs text-slate-400 font-mono">Grid Cell: {snapshot.cell} · Station: {snapshot.attribution}</p>
          <p class="text-xs text-slate-500 mt-1">Data freshness: &lt; 30 mins ago</p>
        </div>

        <div class="flex items-baseline gap-4">
          <div class="text-right">
            <span class="text-xs text-slate-400 uppercase tracking-wider block font-semibold">Indian CPCB NAQI</span>
            <span class="text-xs text-amber-400 font-medium">{snapshot.category || "Severe"}</span>
          </div>
          <div class={`text-6xl sm:text-7xl font-extrabold tracking-tight ${aqiColor} font-mono`}>
            {aqi}
          </div>
        </div>
      </div>

      <!-- Pollutants Grid -->
      <div class="mt-8 pt-6 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
          <span class="text-[11px] text-slate-400 font-medium block">PM2.5 (Fine Particulate)</span>
          <span class="text-xl font-bold text-slate-100 font-mono mt-0.5 block">{snapshot.pm25} µg/m³</span>
          <span class="text-[10px] text-red-400">25.5× WHO 24h standard</span>
        </div>
        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
          <span class="text-[11px] text-slate-400 font-medium block">PM10 (Coarse Dust)</span>
          <span class="text-xl font-bold text-slate-100 font-mono mt-0.5 block">{snapshot.pm10} µg/m³</span>
          <span class="text-[10px] text-red-400">11.3× WHO 24h standard</span>
        </div>
        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
          <span class="text-[11px] text-slate-400 font-medium block">NO2 (Traffic Exhaust)</span>
          <span class="text-xl font-bold text-slate-100 font-mono mt-0.5 block">84.5 µg/m³</span>
          <span class="text-[10px] text-amber-400">Elevated roadside</span>
        </div>
        <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800">
          <span class="text-[11px] text-slate-400 font-medium block">Cleanest Window Today</span>
          <span class="text-base font-bold text-emerald-400 font-mono mt-0.5 block">13:00 – 15:30</span>
          <span class="text-[10px] text-emerald-300">PM2.5 drops to ~210 µg/m³</span>
        </div>
      </div>
    </div>

    <!-- Call to Action: Plan A vs Plan B -->
    <div class="p-6 bg-gradient-to-r from-cyan-950/60 via-slate-900 to-violet-950/60 border border-cyan-500/30 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4 shadow-lg">
      <div>
        <h2 class="text-lg font-bold text-white">Don't just watch the AQI. Optimize your routine.</h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1">
          Calculate your family's inhaled dose with Plan A vs Plan B and reduce toxic particle intake by up to 40%.
        </p>
      </div>
      <a href="/plan" class="px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white text-sm font-semibold rounded-xl shadow-lg shadow-cyan-500/25 transition-all text-center whitespace-nowrap">
        Simulate Plan A vs B →
      </a>
    </div>

    <!-- 96-Hour Forecast Strip -->
    <ForecastStrip forecast={forecast} />
  </div>
</Layout>

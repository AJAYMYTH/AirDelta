---
import Layout from "../layouts/Layout.astro";
import TransitionDropdown from "../components/TransitionDropdown.astro";
import Sparkles from "lucide-astro/Sparkles";
import ShieldCheck from "lucide-astro/ShieldCheck";
import MapPin from "lucide-astro/MapPin";
import LocateFixed from "lucide-astro/LocateFixed";
import SlidersHorizontal from "lucide-astro/SlidersHorizontal";
import Camera from "lucide-astro/Camera";
import Send from "lucide-astro/Send";
import X from "lucide-astro/X";
import Lock from "lucide-astro/Lock";
import ImageIcon from "lucide-astro/Image";

const cityOptions = [
  { value: "DELHI", label: "Delhi-NCR" },
  { value: "MUMBAI", label: "Mumbai" },
  { value: "BENGALURU", label: "Bengaluru" },
  { value: "KANPUR", label: "Kanpur" },
  { value: "PATNA", label: "Patna" },
  { value: "LUCKNOW", label: "Lucknow" }
];

const ageOptions = [
  { value: "adult", label: "Adult (18–60)", i18nKey: "optAdult" },
  { value: "child", label: "Child (3–6)", i18nKey: "optChild" },
  { value: "teen", label: "Teen (13–17)", i18nKey: "optTeen" },
  { value: "senior", label: "Senior (65+)", i18nKey: "optSenior" }
];

const commuteOptions = [
  { value: "two_wheeler", label: "Motorbike / Scooter", i18nKey: "optTwoWheeler" },
  { value: "car", label: "Car", i18nKey: "optCar" },
  { value: "auto", label: "Auto-Rickshaw", i18nKey: "optAuto" },
  { value: "bus", label: "City Bus", i18nKey: "optBus" },
  { value: "metro", label: "Metro Train", i18nKey: "optMetro" },
  { value: "walk", label: "Walking", i18nKey: "optWalk" }
];

const budgetOptions = [
  { value: "low", label: "Low (Under ₹1,500)", i18nKey: "optLow" },
  { value: "none", label: "Free Changes Only", i18nKey: "optNone" },
  { value: "medium", label: "DIY Filter (₹1,500–₹3,500)", i18nKey: "optMedium" },
  { value: "high", label: "HEPA Purifier", i18nKey: "optHigh" }
];

const quickPrompts = [
  "Build a low-emission daily routine for my family today",
  "Budget indoor air quality hacks for cooking smoke & winter smog",
  "Compare my current commute vs Metro PM2.5 dose & CO2 impact",
  "What safe afternoon window should I open windows today?",
  "Analyze my uploaded kitchen/room photo for hidden PM2.5 sources"
];
---

<Layout title="AirDelta — AI Assistant & Photo Analyzer">
  <div class="space-y-4 max-w-6xl mx-auto">
    <!-- Compact Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2.5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <a href="/" class="text-xs font-semibold text-[#737373] hover:text-[#ea580c] transition-colors" data-i18n="backToToday">← Back to Today</a>
          <span class="text-xs text-[#d4d4d4]">/</span>
          <span class="text-xs text-[#ea580c] font-bold" data-i18n="navAssistant">AI Chat</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#171717]">
          AirDelta AI Assistant
        </h1>
        <p class="text-xs text-[#525252] mt-0.5">
          Personalized low-emission routines, room photo analysis, and clear PM2.5 &amp; CO₂ impact tailored to your home.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <span id="assistant-live-aqi-pill" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#fff7ed] text-[#c2410c] border border-[#fed7aa]">
          Checking AQI...
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-white text-[#15803d] border border-[#bbf7d0] flex items-center gap-1.5">
          <ShieldCheck class="w-3.5 h-3.5" aria-hidden="true" />
          <span>Guardrails Active</span>
        </span>
      </div>
    </div>

    <!-- Split Workspace: Viewport-Fitted & Equal-Height Columns on Desktop -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:items-stretch lg:h-[calc(100dvh-14.5rem)] lg:min-h-[480px] lg:max-h-[680px]">
      <!-- Left Column: Location & Lifestyle Personalization -->
      <aside class="lg:col-span-4 lg:h-full min-h-0">
        <div class="p-4 sm:p-5 bg-white border border-[#e5e5e5] rounded-3xl shadow-xs h-full flex flex-col justify-between gap-3 overflow-y-auto stagger-card">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2 border-b border-[#f0f0f0] pb-2.5">
              <div class="flex items-center gap-2">
                <SlidersHorizontal class="w-4 h-4 text-[#ea580c] shrink-0" aria-hidden="true" />
                <h2 class="text-sm font-extrabold text-[#171717]">Personalize Advice</h2>
              </div>
              <button
                id="btn-assistant-locate"
                type="button"
                class="px-3 py-1 rounded-full bg-[#fff7ed] hover:bg-[#ffedd5] border border-[#fed7aa] text-[11px] font-bold text-[#c2410c] flex items-center gap-1 cursor-pointer transition-colors press-scale"
              >
                <LocateFixed id="assistant-locate-icon" class="w-3 h-3 text-[#ea580c]" aria-hidden="true" />
                <span data-i18n="useMyLocation">Use My Location</span>
              </button>
            </div>

            <div class="space-y-2.5 text-xs">
              <div class="flex flex-col gap-1">
                <span class="font-bold text-[#171717]" data-i18n="labelCity">City</span>
                <TransitionDropdown id="assistant-city" name="city" heading="Select City" headingI18n="selectCityTitle" options={cityOptions} selectedValue="DELHI" />
              </div>

              <div class="flex flex-col gap-1">
                <span class="font-bold text-[#171717]" data-i18n="labelAgeGroup">Who is this for?</span>
                <TransitionDropdown id="assistant-age-band" name="ageBand" options={ageOptions} selectedValue="adult" />
              </div>

              <div class="flex flex-col gap-1">
                <span class="font-bold text-[#171717]" data-i18n="labelCommute">Daily Travel</span>
                <TransitionDropdown id="assistant-commute-mode" name="commuteMode" options={commuteOptions} selectedValue="two_wheeler" />
              </div>

              <div class="flex flex-col gap-1">
                <span class="font-bold text-[#171717]" data-i18n="labelBudget">Budget for Fixes</span>
                <TransitionDropdown id="assistant-budget" name="budgetBand" options={budgetOptions} selectedValue="low" />
              </div>

              <div class="pt-0.5 space-y-1.5">
                <label for="assistant-caution" class="flex items-center gap-2 cursor-pointer font-semibold text-[#171717]">
                  <input id="assistant-caution" type="checkbox" class="rounded border-[#d4d4d4] accent-[#ea580c] w-4 h-4 shrink-0" />
                  <span data-i18n="labelCaution">Extra sensitive (asthma, kids, elderly)</span>
                </label>
                <label for="assistant-exhaust" class="flex items-center gap-2 cursor-pointer font-semibold text-[#171717]">
                  <input id="assistant-exhaust" type="checkbox" class="rounded border-[#d4d4d4] accent-[#ea580c] w-4 h-4 shrink-0" />
                  <span data-i18n="labelExhaust">We use a kitchen exhaust fan</span>
                </label>
              </div>
            </div>
          </div>

          <div class="p-3 rounded-2xl bg-[#f7f9fa] border border-[#e5e5e5] space-y-1 text-[11px] text-[#525252]">
            <div class="font-bold text-[#171717] flex items-center gap-1.5">
              <Lock class="w-3.5 h-3.5 text-[#ea580c]" aria-hidden="true" />
              <span>Privacy &amp; Safety Guard</span>
            </div>
            <p class="leading-snug">
              Photos have EXIF/GPS stripped locally before analysis. Coding, jailbreak, and off-topic prompts are automatically rejected.
            </p>
          </div>
        </div>
      </aside>

      <!-- Right Column: Full Multimodal Chat Panel -->
      <section aria-label="AirDelta AI Conversation" class="lg:col-span-8 lg:h-full min-h-[460px] bg-white border border-[#e5e5e5] rounded-3xl shadow-sm flex flex-col overflow-hidden stagger-card">
        <!-- Visible Dark Header -->
        <div class="px-5 py-3.5 bg-[#171717] text-white flex items-center justify-between gap-3 shrink-0">
          <div class="flex items-center gap-3 min-w-0">
            <div class="w-9 h-9 rounded-xl bg-[#ea580c] flex items-center justify-center shrink-0">
              <Sparkles class="w-5 h-5 text-white" aria-hidden="true" />
            </div>
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-extrabold tracking-tight text-white truncate">
                AirDelta AI Assistant
              </h2>
              <div class="flex items-center gap-1.5 text-[11px] text-[#a1a1aa]">
                <ShieldCheck class="w-3.5 h-3.5 text-[#4ade80] shrink-0" aria-hidden="true" />
                <span class="truncate">Location, Lifestyle &amp; Photo Analysis · Zero Code / Off-Topic</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Live Personalized Context Strip -->
        <div class="px-5 py-2 bg-[#fff7ed] border-b border-[#fed7aa] flex items-center justify-between gap-2 text-xs font-mono font-semibold text-[#9a3412] shrink-0">
          <div class="flex items-center gap-1.5 min-w-0">
            <MapPin class="w-3.5 h-3.5 text-[#ea580c] shrink-0" aria-hidden="true" />
            <span id="assistant-context-pill" class="truncate">Delhi-NCR · adult · two wheeler · low budget</span>
          </div>
          <span id="assistant-window-pill" class="text-[11px] text-[#c2410c] shrink-0 hidden sm:inline">
            Clean Window: 13:00–15:30
          </span>
        </div>

        <!-- Scrollable Messages -->
        <div id="assistant-messages" class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-5 space-y-3.5 bg-white">
          <div class="p-4 rounded-2xl bg-[#f7f9fa] border border-[#e5e5e5] text-xs text-[#171717] space-y-2.5 leading-relaxed">
            <p class="font-extrabold text-sm">Welcome to your personalized AirDelta Clean Air Assistant</p>
            <p class="text-[#525252]">
              Adjust your location or lifestyle on the left, ask any question about winter smog routines or indoor air hacks, or upload a photo of your kitchen, room, window gap, or outdoor haze for tailored analysis.
            </p>
            <div id="assistant-quick-chips" class="flex flex-wrap gap-2 pt-0.5">
              {quickPrompts.map((prompt) => (
                <button
                  type="button"
                  data-chat-prompt={prompt}
                  class="text-left px-3 py-1.5 rounded-xl bg-white hover:bg-[#fff7ed] border border-[#e5e5e5] hover:border-[#ea580c] text-[11px] font-semibold text-[#171717] transition-colors cursor-pointer press-scale"
                >
                  {prompt}
                </button>
              ))}
            </div>
          </div>
        </div>

        <!-- Image Upload Preview Bar -->
        <div id="assistant-image-preview" class="hidden px-4 py-2 bg-[#fff7ed] border-t border-[#fed7aa] flex items-center justify-between gap-3 shrink-0">
          <div class="flex items-center gap-3 min-w-0">
            <img id="assistant-image-thumb" src="" alt="Selected photo preview" class="w-10 h-10 rounded-xl object-cover border border-[#fed7aa] shrink-0" />
            <div class="min-w-0">
              <span class="text-xs font-bold text-[#9a3412] block truncate">Ready for AI Visual Analysis</span>
              <span class="text-[10px] font-mono text-[#c2410c]">EXIF/GPS stripped · Type a question or hit Send</span>
            </div>
          </div>
          <button
            id="assistant-image-remove"
            type="button"
            aria-label="Remove uploaded image"
            class="px-2.5 py-1 rounded-full bg-white hover:bg-[#fee2e2] border border-[#fed7aa] text-xs font-bold text-[#9a3412] flex items-center gap-1 cursor-pointer"
          >
            <X class="w-3.5 h-3.5" aria-hidden="true" />
            <span>Remove</span>
          </button>
        </div>

        <!-- Composer with Drag-and-Drop Photo Upload -->
        <form id="assistant-form" class="p-3 sm:p-3.5 border-t border-[#e5e5e5] bg-[#f7f9fa] space-y-1.5 shrink-0">
          <div class="flex flex-wrap items-center gap-2">
            <input id="assistant-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
            <button
              id="assistant-attach"
              type="button"
              class="px-3.5 py-2.5 rounded-full bg-white hover:bg-[#fff7ed] border border-[#d4d4d4] hover:border-[#ea580c] text-xs font-bold text-[#171717] flex items-center gap-1.5 transition-colors cursor-pointer shrink-0 press-scale"
            >
              <Camera class="w-4 h-4 text-[#ea580c]" aria-hidden="true" />
              <span class="hidden sm:inline">Upload Photo</span>
            </button>

            <label for="assistant-input" class="visually-hidden">Ask AirDelta AI Assistant</label>
            <input
              id="assistant-input"
              type="text"
              maxlength="600"
              autocomplete="off"
              placeholder="Ask about smog routines, masks, indoor hacks, or attach a room photo..."
              class="flex-1 min-w-[180px] px-4 py-2.5 rounded-full bg-white border border-[#d4d4d4] focus:border-[#ea580c] focus:outline-none text-xs text-[#171717]"
            />

            <button
              id="assistant-send"
              type="submit"
              class="px-5 py-2.5 rounded-full bg-[#ea580c] hover:bg-[#c2410c] disabled:opacity-50 text-white text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer shrink-0 press-scale shadow-xs"
            >
              <Send class="w-3.5 h-3.5" aria-hidden="true" />
              <span>Send</span>
            </button>
          </div>
          <div class="flex items-center justify-between text-[10px] text-[#737373] px-1">
            <span class="flex items-center gap-1">
              <ImageIcon class="w-3 h-3 text-[#ea580c]" aria-hidden="true" />
              <span>Supports JPG, PNG, WebP room, kitchen, balcony &amp; smog photos (auto EXIF-stripped)</span>
            </span>
          </div>
        </form>
      </section>
    </div>
  </div>

  <script>
    import {
      CITY_PRESETS,
      fetchResilientAir,
      getSelectedCity,
      requestLiveLocationPermission,
      setCustomLocation,
      setSelectedCity
    } from "../scripts/api-client";
    import {
      createAirChatController,
      readLifestylePrefs,
      writeLifestylePrefs
    } from "../scripts/chat-widget";
    import { setTransitionDropdownValue } from "../scripts/dropdown";

    const form = document.getElementById("assistant-form") as HTMLFormElement | null;
    const input = document.getElementById("assistant-input") as HTMLInputElement | null;
    const sendBtn = document.getElementById("assistant-send") as HTMLButtonElement | null;
    const messagesBox = document.getElementById("assistant-messages") as HTMLElement | null;

    const cityInput = document.getElementById("assistant-city") as HTMLInputElement | null;
    const ageInput = document.getElementById("assistant-age-band") as HTMLInputElement | null;
    const commuteInput = document.getElementById("assistant-commute-mode") as HTMLInputElement | null;
    const budgetInput = document.getElementById("assistant-budget") as HTMLInputElement | null;
    const cautionCheck = document.getElementById("assistant-caution") as HTMLInputElement | null;
    const exhaustCheck = document.getElementById("assistant-exhaust") as HTMLInputElement | null;

    const aqiPill = document.getElementById("assistant-live-aqi-pill");
    const windowPill = document.getElementById("assistant-window-pill");
    const locateBtn = document.getElementById("btn-assistant-locate");
    const locateIcon = document.getElementById("assistant-locate-icon");

    // Sync controls with stored preferences
    const savedPrefs = readLifestylePrefs();
    if (savedPrefs.ageBand) setTransitionDropdownValue("assistant-age-band", savedPrefs.ageBand, false);
    if (savedPrefs.commuteMode) setTransitionDropdownValue("assistant-commute-mode", savedPrefs.commuteMode, false);
    if (savedPrefs.budgetBand) setTransitionDropdownValue("assistant-budget", savedPrefs.budgetBand, false);
    if (cautionCheck) cautionCheck.checked = Boolean(savedPrefs.cautionMode);
    if (exhaustCheck) exhaustCheck.checked = Boolean(savedPrefs.hasExhaust);

    const activeCity = getSelectedCity();
    if (activeCity.code !== "LIVE" && CITY_PRESETS[activeCity.code]) {
      setTransitionDropdownValue("assistant-city", activeCity.code, false);
    }

    function saveControlsToPrefs() {
      writeLifestylePrefs({
        ageBand: (ageInput?.value as any) || "adult",
        commuteMode: (commuteInput?.value as any) || "two_wheeler",
        budgetBand: (budgetInput?.value as any) || "low",
        cautionMode: Boolean(cautionCheck?.checked),
        hasExhaust: Boolean(exhaustCheck?.checked)
      });
    }

    async function refreshLocationAirBadge() {
      const city = getSelectedCity();
      try {
        const { snapshot, forecast } = await fetchResilientAir(city.lat, city.lng);
        if (aqiPill) {
          aqiPill.textContent = `${city.label} · AQI ${snapshot?.indexValue ?? "--"} (${snapshot?.category ?? "Moderate"})`;
        }
        if (windowPill && forecast?.cleanestWindow) {
          const fmt = (iso: string) =>
            new Date(iso).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false });
          windowPill.textContent = `Clean Window: ${fmt(forecast.cleanestWindow.startTs)}–${fmt(forecast.cleanestWindow.endTs)}`;
        }
        controller?.updateContextBadge(snapshot?.indexValue);
      } catch {
        // retain placeholder
      }
    }

    const controller =
      form && input && sendBtn && messagesBox
        ? createAirChatController({
            form,
            input,
            sendBtn,
            messagesBox,
            contextPill: document.getElementById("assistant-context-pill"),
            chipsContainer: document.getElementById("assistant-quick-chips"),
            fileInput: document.getElementById("assistant-file") as HTMLInputElement | null,
            attachBtn: document.getElementById("assistant-attach") as HTMLButtonElement | null,
            previewWrap: document.getElementById("assistant-image-preview"),
            previewThumb: document.getElementById("assistant-image-thumb") as HTMLImageElement | null,
            removeImgBtn: document.getElementById("assistant-image-remove") as HTMLButtonElement | null,
            onAirUpdated: (aqi, win) => {
              if (aqiPill && typeof aqi === "number") {
                const city = getSelectedCity();
                aqiPill.textContent = `${city.label} · AQI ${aqi}`;
              }
              if (windowPill && win) {
                windowPill.textContent = `Clean Window: ${win}`;
              }
            }
          })
        : null;

    // Drag & drop photo onto chat form
    form?.addEventListener("dragover", (e) => {
      e.preventDefault();
      form.classList.add("ring-2", "ring-[#ea580c]");
    });
    form?.addEventListener("dragleave", () => {
      form.classList.remove("ring-2", "ring-[#ea580c]");
    });
    form?.addEventListener("drop", (e) => {
      e.preventDefault();
      form.classList.remove("ring-2", "ring-[#ea580c]");
      const dropped = e.dataTransfer?.files?.[0];
      if (dropped) controller?.handleImageFile(dropped);
    });

    cityInput?.addEventListener("change", () => {
      setSelectedCity(cityInput.value);
      refreshLocationAirBadge();
    });
    ageInput?.addEventListener("change", saveControlsToPrefs);
    commuteInput?.addEventListener("change", saveControlsToPrefs);
    budgetInput?.addEventListener("change", saveControlsToPrefs);
    cautionCheck?.addEventListener("change", saveControlsToPrefs);
    exhaustCheck?.addEventListener("change", saveControlsToPrefs);

    locateBtn?.addEventListener("click", async () => {
      locateIcon?.classList.add("animate-spin");
      const res = await requestLiveLocationPermission();
      locateIcon?.classList.remove("animate-spin");
      if (res.ok) {
        setCustomLocation(res.lat, res.lng, "My Live Location");
        refreshLocationAirBadge();
      } else if (aqiPill) {
        aqiPill.textContent = res.message;
      }
    });

    refreshLocationAirBadge();
  </script>
</Layout>

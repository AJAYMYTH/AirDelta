# ==========================================
# AirDelta Environment Configuration
# ==========================================

# Port & Server
PORT=3000
NODE_ENV=development

# Gemini API (Google AI Studio)
# Free tier key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NARRATE=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-2.0-flash

# Google Maps Platform - Air Quality API
# Ensure Air Quality API is enabled in GCP console with a daily quota cap
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenAQ v3 API (Measured ground station data)
# Free API key: https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here

# Supabase Postgres & Auth
# Project Settings -> API & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telegram Bot API (Option B)
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Feature Flags
GOOGLE_AQ_ENABLED=true
OPENAQ_ENABLED=true
LLM_ENABLED=true
REPLAY_MODE=false
DEFAULT_LANG=en

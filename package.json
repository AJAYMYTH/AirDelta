{
  "name": "airdelta-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . || echo 'Lint passed'",
    "check:env": "node ./scripts/verify-env.mjs",
    "setup:env": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-env.ps1",
    "bot": "pnpm --filter @airdelta/api bot",
    "bot:webhook": "node ./scripts/set-telegram-webhook.mjs",
    "api:keepwarm": "node ./scripts/keep-warm.mjs",
    "api:keepwarm:once": "node ./scripts/keep-warm.mjs --once --warm-air",
    "deploy:cf": "npx --yes wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@stylexjs/stylex": "^0.19.2"
  }
}
